<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>APC.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\APC.Core\APC.Core.csproj" />
    <ProjectReference Include="..\APC.Arca\APC.Arca.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los scripts viajan con la app: el panel de base de datos los lee de ahí -->
    <Content Include="..\..\sql\*.sql" Link="sql\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los secretos no se versionan ni se publican: en la VPS se crean a mano -->
    <Content Update="appsettings.Secretos.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
