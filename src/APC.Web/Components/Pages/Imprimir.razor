@page "/imprimir/{Id:guid}"
@layout VacioLayout
@attribute [Authorize(Roles = SesionService.RolEmpleado)]
@inject SesionService SesionSrv
@inject CatalogoService Catalogo
@inject FacturacionService Facturacion
@inject EmpresaCentralService EmpresaSrv

<PageTitle>@ComprobanteVista.TituloDe(c, empresa)</PageTitle>

<ComprobanteVista C="c" Empresa="empresa" Logo="@logo" Leyenda="@leyenda" Formato="@Formato"
                  RazonSocial="@razonSocial" Fantasia="@fantasia" UrlBase="@UrlBase" />

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "formato")] public string Formato { get; set; }
    /// <summary>nc=1: el Id es de una nota de crédito.</summary>
    [SupplyParameterFromQuery(Name = "nc")] public int? Nc { get; set; }

    private ComprobanteImpresion c;
    private EmpresaDatos empresa;
    private string logo;
    private string leyenda;
    private string razonSocial;
    private string fantasia;

    private string UrlBase => $"/imprimir/{Id}" + (Nc == 1 ? "?nc=1" : "");

    protected override async Task OnInitializedAsync()
    {
        var s = await SesionSrv.ObtenerAsync();
        c = await Facturacion.ObtenerParaImprimirAsync(s.Cs, Id, Nc == 1);
        empresa = await Catalogo.EmpresaAsync(s.Cs);
        logo = await EmpresaSrv.LogoDataUriAsync(s.Tenant.Id);
        leyenda = s.Sucursal?.LeyendaTicket is { Length: > 0 } propia ? propia : s.Tenant.LeyendaTicket;
        razonSocial = s.Tenant.Nombre;
        fantasia = s.Tenant.NombreFantasia;
    }
}
