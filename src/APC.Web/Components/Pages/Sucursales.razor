@page "/sucursales"
@attribute [Authorize(Roles = SesionService.RolEmpleado)]
@using APC.Core.Tenants
@inject SesionService SesionSrv
@inject NavigationManager Nav
@inject SucursalService SucursalSrv
@inject CatalogoService Catalogo

<PageTitle>Sucursales · Factu360</PageTitle>

<div class="page-pad">
    <header class="fact-head">
        <div class="fact-titulo">
            <h1>Sucursales</h1>
            <span class="sub">Stock por sucursal: ajustes y transferencias</span>
        </div>
    </header>

    @if (mensaje != null)
    {
        <p class="alerta @(mensajeOk ? "alerta-ok" : "alerta-error")" role="status">@mensaje</p>
    }

    <nav class="pestanias" aria-label="Secciones">
        <button type="button" class="pestania @(pestania == 0 ? "activa" : "")" @onclick="() => pestania = 0">Mis sucursales</button>
        <button type="button" class="pestania @(pestania == 1 ? "activa" : "")" @onclick="() => pestania = 1">Mover stock</button>
        <button type="button" class="pestania @(pestania == 2 ? "activa" : "")" @onclick="VerMovimientos">Movimientos</button>
    </nav>

    @if (pestania == 0)
    {
        <div class="panel tabla-scroll">
            <table class="tabla">
                <thead><tr><th class="der">Pto. Vta.</th><th>Sucursal</th><th>Domicilio</th><th>Teléfono</th><th>Apertura de caja</th><th>QR del comercio</th><th>Estado</th></tr></thead>
                <tbody>
                    @if (lista.Count == 0)
                    {
                        <tr><td colspan="6" class="sub">Todavía no hay sucursales cargadas.</td></tr>
                    }
                    @foreach (var s in lista)
                    {
                        <tr class="@(s.Activa ? "" : "fila-baja") @(verCaja?.Id == s.Id ? "fila-sel" : "")">
                            <td class="der mono">@s.PuntoVenta.ToString("0000")</td>
                            <td>
                                @if (sesion.EsAdmin)
                                {
                                    <button type="button" class="link-fila" @onclick="() => AbrirCaja(s)">@s.Nombre</button>
                                }
                                else
                                {
                                    <span>@s.Nombre</span>
                                }
                            </td>
                            <td>@s.Domicilio@(string.IsNullOrWhiteSpace(s.Localidad) ? "" : " - " + s.Localidad)</td>
                            <td>@s.Telefono</td>
                            <td>
                                @if (s.ExigeCaja) { <span class="cert-chip cert-bien">Sí</span> }
                                else { <span class="etiqueta etiqueta-empleado">No</span> }
                            </td>
                            <td>
                                <button type="button" class="link-fila" @onclick="() => AbrirQr(s)">
                                    @(s.TieneQrPago ? "Cargado" : "Cargar")
                                </button>
                                @if (!string.IsNullOrWhiteSpace(s.QrPagoAlias)) { <span class="sub mono"> · @s.QrPagoAlias</span> }
                            </td>
                            <td>
                                @if (s.Activa) { <span>Activa</span> }
                                else { <span class="etiqueta etiqueta-falta">Inactiva</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (verCaja != null)
        {
            <section class="panel cierre panel-ancho" aria-label="Apertura de caja">
                <h2>@verCaja.Nombre</h2>
                <p class="sub">Pto. Vta. @verCaja.PuntoVenta.ToString("0000")</p>

                <div class="campo">
                    <label for="caja-si">¿Hay que abrir la caja para facturar en esta sucursal?</label>
                    @* Blazor escribe los bool como "True"/"False", así que el select va con texto propio. *@
                    <select id="caja-si" class="input" value="@(exigeCaja ? "si" : "no")" @onchange="ElegirCaja">
                        <option value="si">Sí, primero se abre la caja</option>
                        <option value="no">No, se factura directo</option>
                    </select>
                </div>
                <p class="sub">
                    Con caja, cada usuario abre su turno, el sistema lleva el arqueo y al cerrar compara lo contado
                    con lo esperado. Sin caja se factura directo: es para el dueño que atiende solo.
                    Lo que ya está facturado no cambia.
                </p>

                <div class="fila-btns">
                    <button type="button" class="btn btn-primario" disabled="@ocupado" @onclick="GuardarCaja">Guardar</button>
                    <button type="button" class="btn" @onclick="() => verCaja = null">Cancelar</button>
                </div>
            </section>
        }

        @if (verQr != null)
        {
            <section class="panel cierre panel-ancho" aria-label="QR del comercio">
                <h2>QR del comercio · @verQr.Nombre</h2>
                <p class="sub">
                    Es el QR interoperable que el comercio saca de su app del banco o de MODO. La plata va directo a
                    su cuenta: Factu360 lo muestra en pantalla con el importe y el cajero confirma cuando el cliente pagó.
                </p>

                <div class="fila-campos">
                    <div class="campo">
                        @if (qrUri != null)
                        {
                            <img class="qr-img" src="@qrUri" alt="QR de @verQr.Nombre" />
                        }
                        else
                        {
                            <p class="sub">Todavía no hay ningún QR cargado.</p>
                        }
                    </div>
                    <div class="campo crece">
                        <label for="qr-archivo">Imagen del QR</label>
                        <InputFile id="qr-archivo" class="input input-file" accept=".png,.jpg,.jpeg" disabled="@ocupado"
                                   OnChange="@((InputFileChangeEventArgs a) => SubirQr(a))" />
                        <span class="sub">PNG o JPG, hasta 500 KB. Sacale una captura al QR desde la app del banco.</span>

                        <label for="qr-alias">Alias o CVU</label>
                        <input id="qr-alias" class="input mono" maxlength="100" @bind="qrAlias" placeholder="ej. super.mena.caja" />
                        <span class="sub">Se muestra abajo del QR, por si el cliente prefiere transferir escribiéndolo.</span>
                    </div>
                </div>

                <div class="fila-btns">
                    <button type="button" class="btn btn-primario" disabled="@ocupado" @onclick="GuardarAlias">Guardar alias</button>
                    <button type="button" class="btn" @onclick="() => verQr = null">Cerrar</button>
                    @if (qrUri != null)
                    {
                        <div class="crece"></div>
                        <button type="button" class="btn btn-rojo" disabled="@ocupado" @onclick="QuitarQr">Quitar el QR</button>
                    }
                </div>
            </section>
        }

        <p class="sub">Para abrir una sucursal nueva o cambiar su punto de venta, comunicate con CM Tech: cada punto de venta se da de alta en ARCA.</p>
    }
    else if (pestania == 1)
    {
        <section class="panel panel-ancho">
            <h2>Mover stock</h2>

            <div class="campo">
                <label for="mv-prod">Producto</label>
                <div class="buscador-cliente">
                    <input id="mv-prod" class="input" autocomplete="off" placeholder="Código o descripción, y Enter"
                           @bind="textoProducto" @bind:event="oninput" @onkeydown="BuscarProducto" />
                    @if (productos.Count > 0)
                    {
                        <ul class="resultados" role="listbox" aria-label="Productos">
                            @foreach (var p in productos)
                            {
                                <li>
                                    <button type="button" class="resultado" @onclick="() => ElegirProducto(p)">
                                        <span class="r-nombre">@p.Nombre</span>
                                        <span class="r-cod">@p.Codigo</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            @if (producto != null)
            {
                <h3 class="sub-titulo">@producto.Nombre</h3>
                <table class="tabla">
                    <thead><tr><th>Sucursal</th><th class="der">Stock actual</th></tr></thead>
                    <tbody>
                        @foreach (var s in stock)
                        {
                            <tr><td>@s.Sucursal</td><td class="der fuerte">@s.Stock.ToString("N3", Ar)</td></tr>
                        }
                        <tr class="fila-total"><td>Total</td><td class="der">@stock.Sum(x => x.Stock).ToString("N3", Ar)</td></tr>
                    </tbody>
                </table>

                <div class="fila-campos">
                    <div class="campo">
                        <label for="mv-tipo">Operación</label>
                        <select id="mv-tipo" class="input" value="@(esTransferencia ? "transf" : "ajuste")" @onchange="ElegirTipoMovimiento">
                            <option value="ajuste">Ajuste (entra o sale mercadería)</option>
                            <option value="transf">Transferencia entre sucursales</option>
                        </select>
                    </div>
                    @if (esTransferencia)
                    {
                        <div class="campo">
                            <label for="mv-origen">Desde</label>
                            <select id="mv-origen" class="input" @bind="origenId">
                                @foreach (var s in activas) { <option value="@s.Id">@s.Etiqueta</option> }
                            </select>
                        </div>
                        <div class="campo">
                            <label for="mv-destino">Hacia</label>
                            <select id="mv-destino" class="input" @bind="destinoId">
                                @foreach (var s in activas) { <option value="@s.Id">@s.Etiqueta</option> }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="campo">
                            <label for="mv-suc">Sucursal</label>
                            <select id="mv-suc" class="input" @bind="destinoId">
                                @foreach (var s in activas) { <option value="@s.Id">@s.Etiqueta</option> }
                            </select>
                        </div>
                    }
                    <div class="campo">
                        <label for="mv-cant">Cantidad</label>
                        <input id="mv-cant" class="input mono" type="number" step="0.001" @bind="cantidad" />
                        @if (!esTransferencia)
                        {
                            <span class="sub">En negativo si sale mercadería.</span>
                        }
                    </div>
                </div>

                <div class="campo">
                    <label for="mv-obs">Motivo</label>
                    <input id="mv-obs" class="input" maxlength="300" @bind="observaciones" placeholder="ej. compra a proveedor, rotura, recuento" />
                </div>

                <div class="fila-btns">
                    <button type="button" class="btn btn-primario" disabled="@ocupado" @onclick="Mover">
                        @(esTransferencia ? "Transferir" : "Registrar ajuste")
                    </button>
                </div>
            }
        </section>
    }
    else
    {
        <div class="panel tabla-scroll">
            <table class="tabla">
                <thead><tr><th>Fecha</th><th>Sucursal</th><th>Producto</th><th class="der">Cantidad</th><th>Tipo</th><th>Usuario</th><th>Motivo</th></tr></thead>
                <tbody>
                    @if (movimientos.Count == 0)
                    {
                        <tr><td colspan="7" class="sub">No hay movimientos registrados en los últimos 90 días.</td></tr>
                    }
                    @foreach (var m in movimientos)
                    {
                        <tr>
                            <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@m.Sucursal</td>
                            <td>@m.Producto</td>
                            <td class="der fuerte @(m.Cantidad < 0 ? "negativo" : "")">@m.Cantidad.ToString("N3", Ar)</td>
                            <td>@m.Tipo</td>
                            <td class="mono">@m.Usuario</td>
                            <td>@m.Observaciones</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo Ar = new("es-AR");

    private SesionActual sesion;
    private List<Sucursal> lista = new();
    private List<Sucursal> activas => lista.Where(s => s.Activa).ToList();
    private int pestania;
    private string mensaje;
    private bool mensajeOk;
    private bool ocupado;

    private string textoProducto;
    private List<ProductoItem> productos = new();
    private ProductoItem producto;
    private List<StockEnSucursal> stock = new();
    private bool esTransferencia;
    private Guid origenId;
    private Guid destinoId;
    private decimal cantidad;
    private string observaciones;

    private List<MovimientoStockItem> movimientos = new();

    /// <summary>Sucursal a la que se le está cambiando la apertura de caja.</summary>
    private Sucursal verCaja;
    private bool exigeCaja = true;

    protected override async Task OnInitializedAsync()
    {
        sesion = await SesionSrv.ObtenerAsync();
        // Lo que ve cada rol lo configura CM Tech en Empresas → Módulos.
        if (!sesion.TieneModulo(Modulo.Sucursales)) { Nav.NavigateTo("/sin-permiso"); return; }
        await Recargar();
    }

    private async Task Recargar()
    {
        lista = await SucursalSrv.ListarAsync(sesion.Cs);
        if (lista.Count == 0)
        {
            await SucursalSrv.AsegurarCasaCentralAsync(sesion.Tenant);
            lista = await SucursalSrv.ListarAsync(sesion.Cs);
        }
        var primera = activas.FirstOrDefault();
        if (primera != null)
        {
            if (destinoId == Guid.Empty) destinoId = primera.Id;
            if (origenId == Guid.Empty) origenId = primera.Id;
        }
    }





    /// <summary>Los bool de Blazor se escriben "True"/"False" y no coinciden con el value del option.</summary>
    private void ElegirCaja(ChangeEventArgs e) => exigeCaja = e.Value?.ToString() == "si";

    private void ElegirTipoMovimiento(ChangeEventArgs e) => esTransferencia = e.Value?.ToString() == "transf";

    // ---- QR propio del comercio ----
    private Sucursal verQr;
    private string qrUri;
    private string qrAlias = "";

    private async Task AbrirQr(Sucursal s)
    {
        verQr = s;
        qrAlias = s.QrPagoAlias ?? "";
        mensaje = null;
        qrUri = await SucursalSrv.QrDataUriAsync(sesion.Cs, s.Id);
    }

    private async Task SubirQr(InputFileChangeEventArgs a)
    {
        ocupado = true;
        try
        {
            if (a.File.Size > SucursalService.QrMaximoBytes) { Aviso(false, "La imagen no puede superar los 500 KB."); return; }

            using var ms = new MemoryStream();
            await using (var st = a.File.OpenReadStream(SucursalService.QrMaximoBytes)) await st.CopyToAsync(ms);

            var tipo = a.File.ContentType is { Length: > 0 } ct ? ct : "image/png";
            var error = await SucursalSrv.GuardarQrAsync(sesion.Cs, verQr.Id, ms.ToArray(), tipo, qrAlias);
            if (error != null) { Aviso(false, error); return; }

            qrUri = await SucursalSrv.QrDataUriAsync(sesion.Cs, verQr.Id);
            await Recargar();
            Aviso(true, "QR guardado. Ya se puede cobrar con él en esta sucursal.");
        }
        catch (Exception ex) { Aviso(false, "No se pudo subir la imagen: " + ex.Message); }
        finally { ocupado = false; }
    }

    private async Task GuardarAlias()
    {
        ocupado = true;
        try
        {
            var error = await SucursalSrv.GuardarQrAsync(sesion.Cs, verQr.Id, null, null, qrAlias);
            if (error != null) { Aviso(false, error); return; }
            await Recargar();
            Aviso(true, "Alias guardado.");
        }
        finally { ocupado = false; }
    }

    private async Task QuitarQr()
    {
        ocupado = true;
        try
        {
            await SucursalSrv.QuitarQrAsync(sesion.Cs, verQr.Id);
            qrUri = null;
            await Recargar();
            Aviso(true, "Se quitó el QR de esta sucursal.");
        }
        finally { ocupado = false; }
    }

    private void AbrirCaja(Sucursal s)
    {
        verCaja = s;
        exigeCaja = s.ExigeCaja;
        mensaje = null;
    }

    private async Task GuardarCaja()
    {
        ocupado = true;
        try
        {
            var error = await SucursalSrv.CambiarExigeCajaAsync(sesion.Cs, verCaja.Id, exigeCaja);
            if (error != null) { Aviso(false, error); return; }

            // Si es la sucursal del usuario, que valga ya mismo sin tener que volver a entrar.
            if (sesion.Sucursal != null && sesion.Sucursal.Id == verCaja.Id) sesion.Sucursal.ExigeCaja = exigeCaja;

            Aviso(true, exigeCaja
                ? $"En {verCaja.Nombre} hay que abrir la caja para facturar."
                : $"En {verCaja.Nombre} se factura sin abrir la caja.");
            verCaja = null;
            await Recargar();
        }
        finally { ocupado = false; }
    }

    private async Task BuscarProducto(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(textoProducto)) return;
        productos = await Catalogo.BuscarProductosAsync(sesion.Cs, textoProducto);
        if (productos.Count == 1) await ElegirProducto(productos[0]);
    }

    private async Task ElegirProducto(ProductoItem p)
    {
        producto = p;
        productos.Clear();
        textoProducto = "";
        stock = await SucursalSrv.StockDeProductoAsync(sesion.Cs, p.Id);
    }

    private async Task Mover()
    {
        ocupado = true;
        try
        {
            string error = esTransferencia
                ? await SucursalSrv.TransferirAsync(sesion.Cs, sesion.UsuarioId, origenId, destinoId, producto.Id, cantidad, observaciones)
                : await SucursalSrv.AjustarAsync(sesion.Cs, sesion.UsuarioId, destinoId, producto.Id, cantidad, observaciones);

            if (error != null) { Aviso(false, error); return; }
            Aviso(true, esTransferencia ? "Mercadería transferida." : "Ajuste registrado.");
            cantidad = 0;
            observaciones = null;
            stock = await SucursalSrv.StockDeProductoAsync(sesion.Cs, producto.Id);
        }
        finally { ocupado = false; }
    }

    private async Task VerMovimientos()
    {
        pestania = 2;
        movimientos = await SucursalSrv.MovimientosAsync(sesion.Cs, DateTime.Today.AddDays(-90), DateTime.Today, null, null);
    }

    private void Aviso(bool ok, string t) { mensajeOk = ok; mensaje = t; }
}
