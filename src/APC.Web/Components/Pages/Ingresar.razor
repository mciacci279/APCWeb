@page "/ingresar"
@layout VacioLayout
@attribute [AllowAnonymous]

<PageTitle>Ingresar · APC Web</PageTitle>

<div class="acceso">
    <section class="acceso-marca" aria-label="APC Web">
        <span class="resplandor uno" aria-hidden="true"></span>
        <span class="resplandor dos" aria-hidden="true"></span>

        <div>
            <span class="logo-acceso" role="img" aria-label="APC Web">
                <span class="logo-chip" aria-hidden="true">APC</span>
                <span aria-hidden="true">Web</span>
            </span>
            <p class="lema">Facturación y caja, simple y al día.</p>
            <p class="bajada">Comprobantes de ARCA, arqueo de caja y stock de tu comercio en un solo lugar.</p>
        </div>

        <ul class="acceso-virtudes">
            <li>
                <span class="icono-tono">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"></path><path d="M9 8h6M9 12h6"></path></svg>
                </span>
                Facturas y notas de crédito con CAE, al instante.
            </li>
            <li>
                <span class="icono-tono">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"></rect><path d="M3 10h18M7 15h3"></path></svg>
                </span>
                Cada cajero con su caja; el supervisor ve las de su sucursal.
            </li>
            <li>
                <span class="icono-tono">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7l9-4 9 4-9 4-9-4z"></path><path d="M3 7v10l9 4 9-4V7"></path></svg>
                </span>
                Stock por sucursal, con precios e historial.
            </li>
        </ul>

        <p class="acceso-pie">© @DateTime.Today.Year CM Tech</p>
    </section>

    <div class="acceso-formulario">
        <form class="tarjeta-acceso" method="post" action="/cuenta/ingresar" data-enhance="false">
            <AntiforgeryToken />

            <h1>Ingresar</h1>
            <p class="acceso-bienvenida">Bienvenido/a. Ingresá con el usuario de tu comercio.</p>

            @if (Ok == "clave")
            {
                <p class="alerta alerta-ok" role="status">Listo, tu clave se cambió. Ingresá con la clave nueva.</p>
            }

            @if (Error == "empresa")
            {
                <p class="alerta alerta-error" role="alert">No encontramos esa empresa. Revisá el código.</p>
            }
            else if (Error == "conexion")
            {
                <p class="alerta alerta-error" role="alert">No se pudo conectar con la base de datos. @D</p>
            }
            else if (Error == "suspendida")
            {
                <p class="alerta alerta-error" role="alert">El acceso de esta empresa está suspendido. Comunicate con CM Tech.</p>
            }
            else if (Error == "bloqueado")
            {
                <p class="alerta alerta-error" role="alert">Por demasiados intentos fallidos, el usuario quedó bloqueado 15 minutos. Si no recordás la clave, pedile al administrador que te la cambie.</p>
            }
            else if (Error == "clave")
            {
                <p class="alerta alerta-error" role="alert">Usuario o clave incorrectos.</p>
            }
            else if (Error == "falta-codigo")
            {
                <p class="alerta alerta-aviso" role="status">Esta cuenta tiene verificación en dos pasos. Escribí de nuevo la clave y el código de 6 dígitos de tu app autenticadora.</p>
            }
            else if (Error == "codigo")
            {
                <p class="alerta alerta-error" role="alert">El código de verificación no es correcto. Probá con el código nuevo de la app.</p>
            }

            <div class="campo-acceso">
                <label for="empresa">Empresa</label>
                <div class="input-icono">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"></path><path d="M5 21V7l7-4 7 4v14"></path><path d="M9 21v-6h6v6"></path></svg>
                    <input id="empresa" name="empresa" value="@E" autocomplete="organization" required />
                </div>
            </div>

            <div class="campo-acceso">
                <label for="usuario">Usuario</label>
                <div class="input-icono">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"></circle><path d="M5 20c0-3.9 3.1-7 7-7s7 3.1 7 7"></path></svg>
                    <input id="usuario" name="usuario" value="@U" autocomplete="username" required autofocus="@(!string.IsNullOrEmpty(E))" />
                </div>
            </div>

            <div class="campo-acceso">
                <label for="clave">Clave</label>
                <div class="input-icono">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
                    <input id="clave" name="clave" type="password" autocomplete="current-password" required />
                </div>
            </div>

            @if (PideCodigo)
            {
                <div class="campo-acceso">
                    <label for="codigo">Código de verificación</label>
                    <div class="input-icono">
                        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z"></path><path d="M9 12l2 2 4-4"></path></svg>
                        <input id="codigo" name="codigo" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required />
                    </div>
                </div>
            }

            <button type="submit" class="boton-acceso">Ingresar</button>
            <a class="login-link" href="@LinkRecuperar">¿Olvidaste tu clave?</a>
            <p class="acceso-nota">Lo que ves depende de tu rol: cajero, supervisor o administrador.</p>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string Error { get; set; }
    [SupplyParameterFromQuery(Name = "e")] public string E { get; set; }
    [SupplyParameterFromQuery(Name = "d")] public string D { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string Ok { get; set; }
    [SupplyParameterFromQuery(Name = "u")] public string U { get; set; }
    private bool PideCodigo => Error == "falta-codigo" || Error == "codigo";
    private string LinkRecuperar => string.IsNullOrEmpty(E) ? "/recuperar" : "/recuperar?e=" + Uri.EscapeDataString(E);
}
