@page "/admin/empresas"
@attribute [Authorize(Roles = SesionService.RolSuperAdmin)]
@using APC.Core.Tenants
@inject EmpresaCentralService EmpresaSrv
@inject CertificadoService CertSrv
@inject CatalogoService Catalogo
@inject MercadoPagoService MpSrv
@inject SucursalService SucursalSrv
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Empresas · APC Web</PageTitle>

<div class="page-pad">
    <header class="fact-head">
        <div class="fact-titulo"><h1>Empresas</h1><span class="sub">Panel de CM Tech · @lista.Count empresas</span></div>
        <button type="button" class="btn btn-primario" @onclick="Nueva">+ Nueva empresa</button>
    </header>

    @if (PorVencer.Count > 0)
    {
        <div class="alerta alerta-aviso" role="status">
            <strong>Certificados de ARCA que necesitan atención:</strong>
            <ul class="lista-avisos">
                @foreach (var e in PorVencer)
                {
                    var c = certificados[e.Id];
                    <li>
                        <button type="button" class="link-fila" @onclick="() => Seleccionar(e)">@e.Nombre</button>
                        — @TextoCertificado(c)
                    </li>
                }
            </ul>
        </div>
    }

    @if (mensaje != null)
    {
        <p class="alerta @(mensajeOk ? "alerta-ok" : "alerta-error")" role="status">@mensaje</p>
    }

    <div class="arqueo-cols">
        @* Con una empresa abierta, el detalle ocupa todo el ancho: adentro hay tablas que no entran en una columna. *@
        @if (edit == null)
        {
        <section class="panel crece tabla-scroll">
            <table class="tabla">
                <thead><tr><th>Código</th><th>Razón social</th><th>Nombre de fantasía</th><th>ARCA</th><th class="der">Usuarios</th><th>Estado</th></tr></thead>
                <tbody>
                    @if (lista.Count == 0)
                    {
                        <tr><td colspan="6" class="sub">Todavía no hay empresas. Creá la primera con «Nueva empresa».</td></tr>
                    }
                    @foreach (var e in lista)
                    {
                        <tr class="@(edit?.Id == e.Id ? "fila-sel" : "") @(e.Activa ? "" : "fila-baja")">
                            <td class="mono"><button type="button" class="link-fila" @onclick="() => Seleccionar(e)">@e.Codigo</button></td>
                            <td>@e.Nombre</td>
                            <td>@e.NombreFantasia</td>
                            <td>
                                <span class="etiqueta @(e.EsProduccion ? "etiqueta-admin" : "etiqueta-empleado")">@(e.EsProduccion ? "Producción" : "Homologación")</span>
                                @if (certificados.TryGetValue(e.Id, out var cert))
                                {
                                    <span class="cert-chip @ClaseCertificado(cert)">@TextoCertificado(cert)</span>
                                }
                            </td>
                            @* El punto de venta no va acá: la empresa puede tener varios, uno por sucursal. *@
                            <td class="der">@e.CantidadUsuarios</td>
                            <td>
                                @if (!e.Activa) { <span class="etiqueta etiqueta-falta">Suspendida</span> }
                                else if (e.SuspendidaPorAbono) { <span class="cert-chip cert-mal">Suspendida por abono</span> }
                                else if (e.AbonoVencido) { <span class="cert-chip cert-aviso">Abono vencido · @e.AbonoDiasParaSuspension días</span> }
                                else { <span>Activa</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
        }

        @if (edit != null)
        {
            <section class="panel panel-detalle">
                <div class="fila-btns entre">
                    <h2>
                        <button type="button" class="btn btn-chico" @onclick="Cerrar">← Regresar</button>
                        @(esNueva ? "Nueva empresa" : edit.Nombre)
                    </h2>
                    <button type="button" class="btn-quitar" aria-label="Cerrar panel" @onclick="Cerrar">×</button>
                </div>

                @if (!esNueva)
                {
                    <div class="link-empresa">
                        <span class="sub">Link de ingreso</span>
                        <a class="mono" href="@LinkIngreso" target="_blank" rel="noopener">@LinkIngreso</a>
                        <button type="button" class="btn btn-chico" @onclick="CopiarLink">Copiar</button>
                    </div>

                    <div class="pestanias" role="tablist">
                        <button type="button" role="tab" aria-selected="@(pestania == 0 ? "true" : "false")" class="pestania @(pestania == 0 ? "activa" : "")" @onclick="() => pestania = 0">Datos</button>
                        <button type="button" role="tab" aria-selected="@(pestania == 1 ? "true" : "false")" class="pestania @(pestania == 1 ? "activa" : "")" @onclick="() => pestania = 1">Usuarios</button>
                        <button type="button" role="tab" aria-selected="@(pestania == 3 ? "true" : "false")" class="pestania @(pestania == 3 ? "activa" : "")" @onclick="() => pestania = 3">Sucursales</button>
                        <button type="button" role="tab" aria-selected="@(pestania == 5 ? "true" : "false")" class="pestania @(pestania == 5 ? "activa" : "")" @onclick="() => AbrirNegocio()">Datos fiscales</button>
                        <button type="button" role="tab" aria-selected="@(pestania == 4 ? "true" : "false")" class="pestania @(pestania == 4 ? "activa" : "")" @onclick="() => AbrirModulos()">Módulos</button>
                        <button type="button" role="tab" aria-selected="@(pestania == 6 ? "true" : "false")" class="pestania @(pestania == 6 ? "activa" : "")" @onclick="() => AbrirMercadoPago()">Mercado Pago</button>
                        <button type="button" role="tab" aria-selected="@(pestania == 2 ? "true" : "false")" class="pestania @(pestania == 2 ? "activa" : "")" @onclick="() => pestania = 2">Estado</button>
                    </div>
                }

                @if (esNueva || pestania == 0)
                {
                    @* Tres por fila: el panel ocupa toda la pantalla y el ancho sobra. *@
                    <div class="fila-campos">
                        <div class="campo">
                            <label for="e-codigo">Código de empresa</label>
                            <input id="e-codigo" class="input mono" maxlength="30" @bind="edit.Codigo" disabled="@(!esNueva)" placeholder="ej. mena" />
                        </div>
                        <div class="campo crece"><label for="e-nombre">Razón social</label><input id="e-nombre" class="input" maxlength="150" @bind="edit.Nombre" /></div>
                        <div class="campo crece"><label for="e-fantasia">Nombre de fantasía</label><input id="e-fantasia" class="input" maxlength="150" @bind="edit.NombreFantasia" placeholder="ej. Súper Mena" /></div>
                    </div>
                    <span class="sub">El código lo escribe el cliente al ingresar. Minúsculas, números o guiones. No se puede cambiar después.</span>
                    <div class="campo">
                        <label for="e-cs">Conexión a la base de la empresa</label>
                        <textarea id="e-cs" class="input input-area mono" rows="3" @bind="edit.ConnectionString"
                                  placeholder="Server=.\SQLEXPRESS;Database=SuperMarketDB_Cliente;User ID=apcweb;Password=…;Encrypt=False;TrustServerCertificate=True"></textarea>
                        @if (esNueva)
                        {
                            <div class="fila-btns">
                                <label class="sr-only" for="e-base">Nombre de la base nueva</label>
                                <input id="e-base" class="input mono crece" maxlength="60" @bind="nombreBase" placeholder="@("SuperMarketDB_" + (edit.Codigo ?? "cliente").ToUpperInvariant())" />
                                <button type="button" class="btn btn-chico btn-primario" disabled="@(ocupado || !CodigoListo)" @onclick="CrearBase">@(creandoBase ? "Creando la base…" : "Crear base desde la plantilla")</button>
                            </div>
                            <span class="sub">Copia la base plantilla con ese nombre y completa la conexión sola. Si la base ya existe, pegá la conexión a mano.</span>
                        }
                        <div class="fila-btns">
                            <button type="button" class="btn btn-chico" disabled="@ocupado" @onclick="Probar">Probar conexión</button>
                            @if (prueba != null)
                            {
                                <span class="@(pruebaOk ? "texto-ok" : "texto-error")">@prueba</span>
                            }
                        </div>
                    </div>
                    <div class="fila-campos">
                        <div class="campo"><label for="e-pv">Punto de venta</label><input id="e-pv" class="input" type="number" min="1" @bind="edit.PuntoVenta" /></div>
                        <div class="campo">
                            <label for="e-amb">Ambiente ARCA</label>
                            <select id="e-amb" class="input" @bind="edit.Ambiente">
                                <option value="HOMO">Homologación (pruebas)</option>
                                <option value="PROD">Producción</option>
                            </select>
                        </div>
                        <div class="campo">
                            <label for="e-con">Concepto</label>
                            <select id="e-con" class="input" @bind="edit.Concepto">
                                <option value="1">Productos</option>
                                <option value="2">Servicios</option>
                                <option value="3">Productos y servicios</option>
                            </select>
                        </div>
                    </div>
                    <div class="campo">
                        <label for="e-leyenda">Leyenda al pie del ticket</label>
                        <input id="e-leyenda" class="input" maxlength="200" @bind="edit.LeyendaTicket" placeholder="Dejala vacía para no imprimir leyenda" />
                        <span class="sub">Por ejemplo: «Muchas gracias por su compra!!!» o «Cambios dentro de los 30 días con este ticket».</span>
                    </div>

                    <h2>Logo para las facturas</h2>
                    @if (esNueva)
                    {
                        <p class="sub">Creá la empresa primero; después vas a poder subir el logo.</p>
                    }
                    else
                    {
                        <div class="logo-fila">
                            <div class="logo-preview">
                                @if (logoUri != null)
                                {
                                    <img src="@logoUri" alt="Logo de @edit.Nombre" />
                                }
                                else
                                {
                                    <span class="sub">Sin logo</span>
                                }
                            </div>
                            <div class="campo crece">
                                <label for="e-logo">@(logoUri != null ? "Reemplazar logo" : "Subir logo") (PNG o JPG, hasta 500 KB)</label>
                                <InputFile id="e-logo" class="input input-file" accept=".png,.jpg,.jpeg" disabled="@ocupado"
                                           OnChange="@((InputFileChangeEventArgs a) => SubirLogo(a))" />
                                @if (logoUri != null)
                                {
                                    <button type="button" class="btn btn-chico" @onclick="QuitarLogo">Quitar logo</button>
                                }
                                <span class="sub">Conviene fondo blanco o transparente y forma horizontal. En el ticket de 80 mm sale en blanco y negro.</span>
                            </div>
                        </div>
                    }

                    <h2>Certificado de ARCA · @(edit.EsProduccion ? "producción" : "homologación")</h2>
                    @if (!CodigoListo)
                    {
                        <p class="sub">Escribí primero el código de la empresa para poder subir los archivos.</p>
                    }
                    else
                    {
                        <div class="fila-campos">
                            <div class="campo crece">
                                <label for="e-crt">Certificado (.crt)</label>
                                <InputFile id="e-crt" class="input input-file" accept=".crt,.pem,.cer" disabled="@ocupado"
                                           OnChange="@((InputFileChangeEventArgs a) => Subir(a, false))" />
                            </div>
                            <div class="campo crece">
                                <label for="e-key">Clave privada (.key)</label>
                                <InputFile id="e-key" class="input input-file" accept=".key,.pem" disabled="@ocupado"
                                           OnChange="@((InputFileChangeEventArgs a) => Subir(a, true))" />
                            </div>
                        </div>
                    }

                    @if (certInfo?.Existe == true)
                    {
                        <div class="cert-info @(CertOk ? "ok" : "falta")">
                            <span><strong>@certInfo.Sujeto</strong>@(certInfo.Cuit != null ? " · CUIT " + certInfo.Cuit : "")</span>
                            <span>Vence el @certInfo.Vence?.ToString("dd/MM/yyyy")@(certInfo.Vencido ? " · VENCIDO" : certInfo.VencePronto ? " · vence en menos de 30 días" : "")</span>
                            <span>@(!certInfo.ClaveCargada ? "Falta subir la clave privada." : certInfo.ClaveCoincide ? "La clave corresponde al certificado." : "La clave NO corresponde a este certificado.")</span>
                            <span>Emitido para @(certInfo.EsHomologacion ? "homologación" : "producción")@(AmbienteNoCoincide ? $" · NO SIRVE para {(edit.EsProduccion ? "producción" : "homologación")}: subí el certificado de ese ambiente o cambiá el ambiente" : "")</span>
                        </div>
                    }
                    else if (certInfo?.Error != null)
                    {
                        <p class="alerta alerta-error">@certInfo.Error</p>
                    }
                    else if (!string.IsNullOrEmpty(edit.CertificadoPath))
                    {
                        <p class="alerta alerta-aviso">No se encuentra el certificado en el servidor. Volvé a subirlo.</p>
                    }

                    @if (!string.IsNullOrEmpty(edit.CertificadoPath) || !string.IsNullOrEmpty(edit.ClavePath))
                    {
                        <details class="sub">
                            <summary>Ubicación en el servidor</summary>
                            <div class="mono">@edit.CertificadoPath</div>
                            <div class="mono">@edit.ClavePath</div>
                        </details>
                    }
                    @if (edit.EsProduccion)
                    {
                        <p class="alerta alerta-aviso">En producción las facturas tienen validez fiscal. Usá el certificado de producción.</p>
                    }
                    <button type="button" class="btn btn-primario btn-grande" disabled="@ocupado" @onclick="Guardar">@(esNueva ? "Crear empresa" : "Guardar cambios")</button>
                }
                else if (pestania == 3)
                {
                    <GestionSucursales Tenant="edit" />
                }
                else if (pestania == 6)
                {
                    <h2>Cobro con QR de Mercado Pago</h2>
                    <p class="sub">El comercio pone su propia cuenta: la plata va directo ahí, CM Tech no toca el dinero. Hace falta una aplicación creada en «Tus integraciones» de Mercado Pago, y de ahí sale el access token.</p>

                    @if (mpCuenta == null)
                    {
                        <p class="sub">Todavía no hay una cuenta configurada.</p>
                    }
                    else
                    {
                        <div class="kpis kpis-chicos">
                            <div class="kpi"><span class="sub">Cuenta</span><span class="kpi-num">@(mpCuenta.Apodo ?? "—")</span><span class="sub mono">@mpCuenta.UserId</span></div>
                            <div class="kpi"><span class="sub">Ambiente</span><span class="kpi-num">@(mpCuenta.EsPrueba ? "Prueba" : "Producción")</span></div>
                            <div class="kpi"><span class="sub">Token</span><span class="mono">@mpCuenta.TokenCorto</span></div>
                            <div class="kpi"><span class="sub">Tienda</span><span class="mono">@(mpCuenta.StoreId ?? "sin crear")</span></div>
                        </div>
                    }

                    <div class="fila-campos">
                        <div class="campo crece">
                            <label for="mp-token">Access token</label>
                            <input id="mp-token" class="input mono" maxlength="400" @bind="mpToken"
                                   placeholder="@(mpCuenta == null ? "APP_USR-… o TEST-…" : "Pegá uno nuevo para reemplazarlo")" />
                        </div>
                        <div class="campo">
                            <label for="mp-amb">Ambiente</label>
                            <select id="mp-amb" class="input" @bind="mpAmbiente">
                                <option value="TEST">Prueba</option>
                                <option value="PROD">Producción</option>
                            </select>
                        </div>
                    </div>

                    <div class="fila-btns">
                        <button type="button" class="btn btn-primario" disabled="@ocupado" @onclick="GuardarMp">Guardar y probar</button>
                        @if (mpCuenta != null)
                        {
                            <button type="button" class="btn" disabled="@ocupado" @onclick="SincronizarMp">Crear tienda y cajas</button>
                            <div class="crece"></div>
                            <button type="button" class="btn btn-rojo" disabled="@ocupado" @onclick="BorrarMp">Quitar la cuenta</button>
                        }
                    </div>

                    @if (mpCajas.Count > 0)
                    {
                        <h3 class="sub-titulo">Cajas</h3>
                        <table class="tabla tabla-chica">
                            <thead><tr><th class="der">Pto. Vta.</th><th>Sucursal</th><th>Id en Mercado Pago</th><th>Estado</th></tr></thead>
                            <tbody>
                                @foreach (var c in mpCajas)
                                {
                                    <tr>
                                        <td class="der mono">@c.PuntoVenta.ToString("0000")</td>
                                        <td>@c.Sucursal</td>
                                        <td class="mono">@c.ExternalPosId</td>
                                        <td>@(c.Creada ? "Lista" : "Falta crearla")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <p class="sub">Se crea una caja por sucursal: el QR sale siempre de la caja del punto de venta donde se factura.</p>
                    }
                }
                else if (pestania == 5)
                {
                    <h2>Datos fiscales del negocio</h2>
                    <p class="sub">Son los que salen impresos en la factura y los que se mandan a ARCA. Viven en la base de la empresa, la misma que usa el sistema de escritorio.</p>

                    @if (negocio == null)
                    {
                        <p class="alerta alerta-error">No se pudieron leer los datos: revisá la conexión a la base de esta empresa.</p>
                    }
                    else
                    {
                        <div class="fila-campos">
                            <div class="campo">
                                <label for="n-cuit">CUIT</label>
                                <input id="n-cuit" class="input mono" maxlength="13" @bind="negocio.Cuit" placeholder="30712345678" />
                            </div>
                            <div class="campo crece">
                                <label for="n-ib">Ingresos Brutos</label>
                                <input id="n-ib" class="input" maxlength="50" @bind="negocio.IngresosBrutos" />
                            </div>
                            <div class="campo">
                                <label for="n-inicio">Inicio de actividades</label>
                                <input id="n-inicio" class="input" type="date" @bind="negocio.FechaInicioActividades" />
                            </div>
                        </div>
                        <div class="fila-campos">
                            <div class="campo crece">
                                <label for="n-dom">Domicilio comercial</label>
                                <input id="n-dom" class="input" maxlength="150" @bind="negocio.Domicilio" />
                            </div>
                            <div class="campo">
                                <label for="n-cp">C.P.</label>
                                <input id="n-cp" class="input input-chico" maxlength="10" @bind="negocio.CP" />
                            </div>
                            <div class="campo">
                                <label for="n-tel">Teléfono</label>
                                <input id="n-tel" class="input" maxlength="50" @bind="negocio.Telefono1" />
                            </div>
                            <div class="campo crece">
                                <label for="n-mail">Email</label>
                                <input id="n-mail" class="input" type="email" maxlength="100" @bind="negocio.Email" />
                            </div>
                        </div>

                        <p class="sub">Condición frente al IVA: <strong>@(negocio.CondicionIva ?? "sin definir")</strong>. Se cambia desde el sistema de escritorio.</p>
                        @if (certInfo?.Cuit != null && SoloNumeros(certInfo.Cuit) != SoloNumeros(negocio.Cuit))
                        {
                            <p class="alerta alerta-aviso">El CUIT no coincide con el del certificado de ARCA (@certInfo.Cuit). Así no se van a poder emitir facturas.</p>
                        }

                        <div class="fila-btns">
                            <button type="button" class="btn btn-primario" disabled="@ocupado" @onclick="GuardarNegocio">Guardar datos fiscales</button>
                        </div>

                        <p class="sub">La razón social y el nombre de fantasía que salen en el comprobante se cargan en la solapa «Datos».</p>
                    }
                }
                else if (pestania == 4)
                {
                    <h2>Módulos habilitados</h2>
                    <p class="sub">La columna <strong>Empresa</strong> es lo que tiene contratado: lo que se destilda ahí no lo ve nadie. Las otras dos achican lo que ve cada rol. El administrador del negocio siempre ve todo lo de la empresa.</p>

                    <div class="tabla-scroll">
                        <table class="tabla tabla-chica tabla-modulos">
                            <thead>
                                <tr>
                                    <th>Módulo</th>
                                    <th class="centro">Empresa</th>
                                    <th class="centro">Supervisor</th>
                                    <th class="centro">Cajero</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Modulo.Todos)
                                {
                                    var hayEmpresa = modulos.Contains(m.Clave);
                                    <tr class="@(hayEmpresa ? "" : "fila-baja")">
                                        <td>
                                            <span class="modulo-nombre">@m.Titulo</span>
                                            <span class="sub">@m.Detalle</span>
                                        </td>
                                        <td class="centro">
                                            <input type="checkbox" aria-label="@(m.Titulo) para la empresa" checked="@hayEmpresa"
                                                   @onchange="e => MarcarModulo(modulos, m.Clave, (bool)e.Value)" />
                                        </td>
                                        <td class="centro">
                                            <input type="checkbox" aria-label="@(m.Titulo) para el supervisor" disabled="@(!hayEmpresa)"
                                                   checked="@(hayEmpresa && modulosSup.Contains(m.Clave))"
                                                   @onchange="e => MarcarModulo(modulosSup, m.Clave, (bool)e.Value)" />
                                        </td>
                                        <td class="centro">
                                            <input type="checkbox" aria-label="@(m.Titulo) para el cajero" disabled="@(!hayEmpresa)"
                                                   checked="@(hayEmpresa && modulosEmp.Contains(m.Clave))"
                                                   @onchange="e => MarcarModulo(modulosEmp, m.Clave, (bool)e.Value)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="fila-btns">
                        <button type="button" class="btn btn-primario" disabled="@ocupado" @onclick="GuardarModulos">Guardar módulos</button>
                        <button type="button" class="btn" @onclick="TodosLosModulos">Marcar toda la empresa</button>
                    </div>
                }
                else if (pestania == 1)
                {
                    <GestionUsuarios Tenant="edit" Compacto="true" AdminPorDefecto="true" Cambio="Recargar" />
                }
                else
                {
                    <h2>Abono</h2>
                    @if (edit.SuspendidaPorAbono)
                    {
                        <p class="alerta alerta-error">Suspendida por abono vencido desde el @edit.AbonoFechaSuspension?.ToString("dd/MM/yyyy"). Al registrar el pago vuelve a funcionar en el momento.</p>
                    }
                    else if (edit.AbonoVencido)
                    {
                        <p class="alerta alerta-aviso">El abono venció el @edit.AbonoPagoHasta?.ToString("dd/MM/yyyy"). El cliente ve un aviso y se suspende sola en @edit.AbonoDiasParaSuspension días.</p>
                    }
                    <div class="fila-campos">
                        <div class="campo">
                            <label for="ab-hasta">Pago hasta</label>
                            <input id="ab-hasta" class="input" type="date" @bind="edit.AbonoPagoHasta" />
                        </div>
                        <div class="campo">
                            <label for="ab-gracia">Días de gracia</label>
                            <input id="ab-gracia" class="input mono input-chico" type="number" min="0" max="90" @bind="edit.AbonoDiasGracia" />
                        </div>
                        <div class="campo">
                            <label for="ab-monto">Monto mensual</label>
                            <input id="ab-monto" class="input mono input-chico" type="number" step="0.01" min="0" @bind="edit.AbonoMonto" />
                        </div>
                    </div>
                    <div class="campo"><label for="ab-notas">Notas</label><input id="ab-notas" class="input" maxlength="300" @bind="edit.AbonoNotas" placeholder="ej. paga por transferencia los días 10" /></div>
                    <div class="fila-btns">
                        <button type="button" class="btn btn-primario" disabled="@ocupado" @onclick="GuardarAbono">Guardar abono</button>
                        <button type="button" class="btn" disabled="@ocupado" @onclick="() => SumarMeses(1)">Registrar pago: +1 mes</button>
                        <button type="button" class="btn" disabled="@ocupado" @onclick="QuitarControlAbono">Sin control de abono</button>
                    </div>
                    <p class="sub">Vacío en «Pago hasta» = no se controla el abono. Vencido el día, el cliente ve un aviso; pasados los días de gracia, la empresa se suspende sola.</p>

                    <h2>Suspensión manual</h2>
                    @if (edit.Activa)
                    {
                        <p>La empresa está <strong>activa</strong>. Si la suspendés, nadie de esa empresa puede ingresar y quienes estén adentro salen en su próximo movimiento. Sus datos no se borran.</p>
                        <div class="campo"><label for="e-motivo">Motivo de la suspensión</label><input id="e-motivo" class="input" maxlength="250" @bind="motivo" placeholder="ej. falta de pago" /></div>
                        @if (confirmarSuspension)
                        {
                            <p class="alerta alerta-aviso">¿Suspender a @edit.Nombre?</p>
                            <div class="fila-btns">
                                <button type="button" class="btn" @onclick="() => confirmarSuspension = false">Cancelar</button>
                                <button type="button" class="btn btn-rojo" @onclick="() => CambiarEstado(false)">Sí, suspender</button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="btn btn-rojo btn-grande" @onclick="() => confirmarSuspension = true">Suspender empresa</button>
                        }
                    }
                    else
                    {
                        <p class="alerta alerta-error">Suspendida. Motivo: @edit.MotivoSuspension</p>
                        <button type="button" class="btn btn-primario btn-grande" @onclick="() => CambiarEstado(true)">Reactivar empresa</button>
                    }
                }
            </section>
        }
    </div>
</div>

@code {
    private List<TenantConfig> lista = new();
    private TenantConfig edit;
    private bool esNueva;
    private int pestania;
    /// <summary>Módulos tildados de la empresa que se está editando (vacío = todos).</summary>
    private EmpresaDatos negocio;
    private MercadoPagoCuenta mpCuenta;
    private List<MercadoPagoCaja> mpCajas = new();
    private string mpToken = "";
    private string mpAmbiente = "TEST";
    private HashSet<string> modulos = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> modulosSup = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> modulosEmp = new(StringComparer.OrdinalIgnoreCase);
    private string mensaje;
    private bool mensajeOk;
    private bool ocupado;
    private string prueba;
    private bool pruebaOk;
    private string motivo;
    private bool confirmarSuspension;
    private string nombreBase;
    private bool creandoBase;

    private async Task CrearBase()
    {
        ocupado = true;
        creandoBase = true;
        StateHasChanged();
        try
        {
            var nombre = string.IsNullOrWhiteSpace(nombreBase) ? "SuperMarketDB_" + edit.Codigo.Trim().ToUpperInvariant().Replace("-", "_") : nombreBase.Trim();
            var (cs, err) = await EmpresaSrv.CrearBaseDesdePlantillaAsync(nombre);
            if (err != null) { Aviso(false, err); return; }
            edit.ConnectionString = cs;
            nombreBase = nombre;
            Aviso(true, $"Base «{nombre}» creada desde la plantilla. Cargá los datos fiscales de la empresa en su tabla Empresa, subí el certificado y tocá «Crear empresa».");
        }
        finally { ocupado = false; creandoBase = false; }
    }

    private async Task GuardarAbono()
    {
        ocupado = true;
        try
        {
            var err = await EmpresaSrv.GuardarAbonoAsync(edit.Id, edit.AbonoPagoHasta, edit.AbonoDiasGracia, edit.AbonoMonto, edit.AbonoNotas);
            Aviso(err == null, err ?? "Abono guardado.");
            if (err == null) { var p = pestania; await Recargar(); pestania = p; }
        }
        finally { ocupado = false; }
    }

    /// <summary>Registrar un pago: corre el vencimiento N meses desde el último día pago (o desde hoy si estaba vencido hace mucho).</summary>
    private async Task SumarMeses(int meses)
    {
        var desde = edit.AbonoPagoHasta ?? DateTime.Today;
        edit.AbonoPagoHasta = desde.AddMonths(meses);
        await GuardarAbono();
    }

    private async Task QuitarControlAbono()
    {
        edit.AbonoPagoHasta = null;
        await GuardarAbono();
    }
    private CertificadoInfo certInfo;
    private string logoUri;

    private bool CodigoListo => !string.IsNullOrWhiteSpace(edit?.Codigo) && edit.Codigo.Trim().Length >= 2;
    private bool AmbienteNoCoincide => certInfo?.Existe == true && certInfo.EsHomologacion == edit.EsProduccion;
    private bool CertOk => certInfo?.Existe == true && certInfo.ClaveCoincide && !certInfo.Vencido && !AmbienteNoCoincide;

    private string LinkIngreso => Nav.BaseUri + "ingresar?e=" + edit?.Codigo;

    private async Task CopiarLink()
    {
        await JS.InvokeVoidAsync("apc.copiar", LinkIngreso);
        Aviso(true, "Link copiado: ya se lo podés pasar al cliente.");
    }

    /// <summary>Estado del certificado de ARCA de cada empresa, para avisar antes de que venza.</summary>
    private readonly Dictionary<Guid, CertificadoInfo> certificados = new();

    private List<TenantConfig> PorVencer => lista
        .Where(e => e.Activa && certificados.TryGetValue(e.Id, out var c) && (!c.Existe || c.Vencido || c.VencePronto || !c.ClaveCoincide))
        .ToList();

    private static string ClaseCertificado(CertificadoInfo c) =>
        !c.Existe || c.Vencido || !c.ClaveCoincide ? "cert-mal" : c.VencePronto ? "cert-aviso" : "cert-bien";

    private static string TextoCertificado(CertificadoInfo c)
    {
        if (!c.Existe) return "sin certificado";
        if (!c.ClaveCoincide) return "la clave no corresponde";
        if (c.Vencido) return $"VENCIÓ el {c.Vence:dd/MM/yyyy}";
        var dias = (int)Math.Ceiling((c.Vence.Value - DateTime.Now).TotalDays);
        if (c.VencePronto) return dias <= 1 ? "vence hoy" : $"vence en {dias} días";
        return $"vence el {c.Vence:dd/MM/yyyy}";
    }

    protected override async Task OnInitializedAsync() => await Recargar();

    private async Task Recargar()
    {
        lista = await EmpresaSrv.ListarAsync();
        certificados.Clear();
        foreach (var e in lista) certificados[e.Id] = CertSrv.Leer(e.CertificadoPath, e.ClavePath);
        if (edit != null && !esNueva)
        {
            var actual = lista.FirstOrDefault(e => e.Id == edit.Id);
            if (actual != null) edit = Copia(actual);
        }
    }

    private void Nueva()
    {
        edit = new TenantConfig { Ambiente = "HOMO", Concepto = 1, Moneda = "PES", PuntoVenta = 1 };
        esNueva = true;
        pestania = 0;
        prueba = null;
        certInfo = null;
        mensaje = null;
    }

    private void Seleccionar(TenantConfig e)
    {
        edit = Copia(e);
        esNueva = false;
        pestania = 0;
        prueba = null;
        motivo = null;
        confirmarSuspension = false;
        mensaje = null;
        certInfo = CertSrv.Leer(edit.CertificadoPath, edit.ClavePath);
        logoUri = null;
        _ = CargarLogo(edit.Id);
    }

    private async Task CargarLogo(Guid id)
    {
        var uri = await EmpresaSrv.LogoDataUriAsync(id);
        if (edit?.Id == id) { logoUri = uri; await InvokeAsync(StateHasChanged); }
    }

    private async Task SubirLogo(InputFileChangeEventArgs a)
    {
        ocupado = true;
        try
        {
            if (a.File.Size > EmpresaCentralService.LogoMaximoBytes) { Aviso(false, "El logo no puede superar los 500 KB. Achicá la imagen."); return; }
            using var ms = new MemoryStream();
            await using (var st = a.File.OpenReadStream(EmpresaCentralService.LogoMaximoBytes))
                await st.CopyToAsync(ms);
            var err = await EmpresaSrv.GuardarLogoAsync(edit.Id, ms.ToArray());
            if (err != null) { Aviso(false, err); return; }
            logoUri = await EmpresaSrv.LogoDataUriAsync(edit.Id);
            Aviso(true, "Logo guardado. Ya sale en las facturas nuevas y en las reimpresiones.");
            await Recargar();
        }
        finally { ocupado = false; }
    }

    private async Task QuitarLogo()
    {
        await EmpresaSrv.QuitarLogoAsync(edit.Id);
        logoUri = null;
        Aviso(true, "Logo quitado.");
        await Recargar();
    }

    private void Cerrar() => edit = null;

    private async Task AbrirMercadoPago()
    {
        pestania = 6;
        mensaje = null;
        mpToken = "";
        await CargarMpAsync();
    }

    private async Task CargarMpAsync()
    {
        try
        {
            mpCuenta = await MpSrv.CuentaAsync(edit.Id);
            mpAmbiente = mpCuenta?.Ambiente ?? "TEST";
            mpCajas = await MpSrv.CajasAsync(edit.Id);

            // El nombre de la sucursal vive en la base de la empresa.
            if (mpCajas.Count > 0)
            {
                var sucursales = await SucursalSrv.ListarAsync(edit.ConnectionString);
                foreach (var c in mpCajas)
                    c.Sucursal = sucursales.FirstOrDefault(s => s.PuntoVenta == c.PuntoVenta)?.Nombre ?? "";
            }
        }
        catch (Exception ex)
        {
            mpCuenta = null;
            mpCajas = new();
            Aviso(false, "No se pudo leer la configuración de Mercado Pago. ¿Se ejecutó el script 21? Detalle: " + ex.Message);
        }
    }

    private async Task GuardarMp()
    {
        ocupado = true;
        try
        {
            var token = string.IsNullOrWhiteSpace(mpToken) ? mpCuenta?.AccessToken : mpToken;
            var error = await MpSrv.GuardarCuentaAsync(edit.Id, token, mpAmbiente);
            if (error != null) { Aviso(false, error); return; }
            mpToken = "";
            await CargarMpAsync();
            Aviso(true, $"Conectado a la cuenta {mpCuenta?.Apodo}. Ahora creá la tienda y las cajas.");
        }
        finally { ocupado = false; }
    }

    private async Task SincronizarMp()
    {
        ocupado = true;
        try
        {
            List<Sucursal> sucursales;
            try { sucursales = await SucursalSrv.ListarAsync(edit.ConnectionString, incluirInactivas: false); }
            catch (Exception ex) { Aviso(false, "No se pudieron leer las sucursales: " + ex.Message); return; }

            var error = await MpSrv.SincronizarCajasAsync(edit, sucursales);
            await CargarMpAsync();
            if (error != null) { Aviso(false, error); return; }
            Aviso(true, $"Listo: tienda y {mpCajas.Count(c => c.Creada)} caja(s) creadas en Mercado Pago.");
        }
        finally { ocupado = false; }
    }

    private async Task BorrarMp()
    {
        ocupado = true;
        try
        {
            await MpSrv.BorrarCuentaAsync(edit.Id);
            await CargarMpAsync();
            Aviso(true, "Se quitó la cuenta de Mercado Pago de esta empresa.");
        }
        finally { ocupado = false; }
    }

    private async Task AbrirNegocio()
    {
        pestania = 5;
        mensaje = null;
        negocio = null;
        try { negocio = await Catalogo.EmpresaAsync(edit.ConnectionString); }
        catch (Exception) { negocio = null; }
    }

    private async Task GuardarNegocio()
    {
        ocupado = true;
        try
        {
            var error = await Catalogo.GuardarEmpresaAsync(edit.ConnectionString, negocio);
            if (error != null) { Aviso(false, error); return; }
            Aviso(true, "Datos fiscales guardados.");
        }
        catch (Exception ex) { Aviso(false, "No se pudo guardar: " + ex.Message); }
        finally { ocupado = false; }
    }

    private static string SoloNumeros(string t) => new string((t ?? "").Where(char.IsDigit).ToArray());

    private void AbrirModulos()
    {
        pestania = 4;
        modulos = Leer(edit.Modulos, Modulo.Todos.Select(m => m.Clave));
        modulosSup = Leer(edit.ModulosSupervisor, Modulo.PorDefectoRol);
        modulosEmp = Leer(edit.ModulosEmpleado, Modulo.PorDefectoRol);
    }

    /// <summary>Vacío en la base significa "lo de siempre", distinto para la empresa y para cada rol.</summary>
    private static HashSet<string> Leer(string guardado, IEnumerable<string> siEstaVacio) =>
        string.IsNullOrWhiteSpace(guardado)
            ? siEstaVacio.ToHashSet(StringComparer.OrdinalIgnoreCase)
            : guardado.Split(',', StringSplitOptions.RemoveEmptyEntries)
                      .Select(x => x.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase);

    private void MarcarModulo(HashSet<string> donde, string clave, bool marcado)
    {
        if (marcado) donde.Add(clave); else donde.Remove(clave);
    }

    private void TodosLosModulos() => modulos = Modulo.Todos.Select(m => m.Clave).ToHashSet(StringComparer.OrdinalIgnoreCase);

    private static string Texto(HashSet<string> set) =>
        string.Join(",", Modulo.Todos.Where(m => set.Contains(m.Clave)).Select(m => m.Clave));

    private async Task GuardarModulos()
    {
        ocupado = true;
        try
        {
            // Todos tildados se guarda como vacío: la empresa queda con el sistema completo.
            var todos = modulos.Count >= Modulo.Todos.Length;
            var texto = todos ? null : Texto(modulos);
            // Cada rol se guarda siempre, salvo que coincida con lo de siempre (trabajo diario).
            var porDefecto = Modulo.PorDefectoRol.ToHashSet(StringComparer.OrdinalIgnoreCase);
            var sup = modulosSup.SetEquals(porDefecto) ? null : Texto(modulosSup);
            var emp = modulosEmp.SetEquals(porDefecto) ? null : Texto(modulosEmp);

            var error = await EmpresaSrv.GuardarModulosAsync(edit.Id, texto, sup, emp);
            if (error != null) { Aviso(false, error); return; }
            edit.Modulos = texto;
            edit.ModulosSupervisor = sup;
            edit.ModulosEmpleado = emp;
            await Recargar();
            Aviso(true, $"Módulos guardados. Empresa: {(todos ? "todos" : modulos.Count + " de " + Modulo.Todos.Length)} · " +
                        $"supervisor: {modulosSup.Count(x => modulos.Contains(x))} · cajero: {modulosEmp.Count(x => modulos.Contains(x))}.");
        }
        finally { ocupado = false; }
    }

    private async Task Subir(InputFileChangeEventArgs a, bool esClave)
    {
        ocupado = true;
        try
        {
            edit.Codigo = edit.Codigo?.Trim().ToLowerInvariant();
            await using var st = a.File.OpenReadStream(CertificadoService.MaximoBytes);
            var (ruta, err) = await CertSrv.GuardarAsync(edit.Codigo, edit.Ambiente, esClave, st);
            if (err != null) { Aviso(false, err); return; }
            if (esClave) edit.ClavePath = ruta; else edit.CertificadoPath = ruta;
            certInfo = CertSrv.Leer(edit.CertificadoPath, edit.ClavePath);
            Aviso(true, (esClave ? "Clave privada" : "Certificado") + " subido. Tocá «" + (esNueva ? "Crear empresa" : "Guardar cambios") + "» para aplicarlo.");
        }
        catch (IOException)
        {
            Aviso(false, "El archivo es demasiado grande para ser un certificado.");
        }
        finally { ocupado = false; }
    }

    private async Task Probar()
    {
        ocupado = true;
        try
        {
            (pruebaOk, prueba) = await EmpresaSrv.ProbarConexionAsync(edit.ConnectionString);
        }
        finally { ocupado = false; }
    }

    private async Task Guardar()
    {
        ocupado = true;
        try
        {
            bool eraNueva = esNueva;
            var err = await EmpresaSrv.GuardarAsync(edit);
            if (err != null) { Aviso(false, err); return; }
            await Recargar();
            esNueva = false;
            if (eraNueva)
            {
                pestania = 1;
                Aviso(true, $"Empresa «{edit.Nombre}» creada. Ahora creá el usuario administrador del dueño.");
            }
            else
            {
                Aviso(true, "Cambios guardados.");
            }
        }
        finally { ocupado = false; }
    }

    private async Task CambiarEstado(bool activa)
    {
        var err = await EmpresaSrv.CambiarEstadoAsync(edit.Id, activa, motivo);
        Aviso(err == null, err ?? (activa ? $"{edit.Nombre} reactivada." : $"{edit.Nombre} suspendida."));
        confirmarSuspension = false;
        if (err == null) await Recargar();
    }

    private void Aviso(bool ok, string t) { mensajeOk = ok; mensaje = t; }

    private static TenantConfig Copia(TenantConfig e) => new()
    {
        Id = e.Id, Codigo = e.Codigo, Nombre = e.Nombre, NombreFantasia = e.NombreFantasia, ConnectionString = e.ConnectionString, PuntoVenta = e.PuntoVenta,
        Ambiente = e.Ambiente?.Trim(), CertificadoPath = e.CertificadoPath, ClavePath = e.ClavePath, Concepto = e.Concepto,
        Moneda = e.Moneda, Activa = e.Activa, MotivoSuspension = e.MotivoSuspension, FechaAlta = e.FechaAlta,
        AbonoPagoHasta = e.AbonoPagoHasta, AbonoDiasGracia = e.AbonoDiasGracia, AbonoMonto = e.AbonoMonto, AbonoNotas = e.AbonoNotas,
        CantidadUsuarios = e.CantidadUsuarios, TieneLogo = e.TieneLogo, LeyendaTicket = e.LeyendaTicket,
        Modulos = e.Modulos, ModulosSupervisor = e.ModulosSupervisor, ModulosEmpleado = e.ModulosEmpleado
    };
}
