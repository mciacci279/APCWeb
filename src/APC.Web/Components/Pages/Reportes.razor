@page "/reportes"
@attribute [Authorize(Roles = SesionService.RolEmpleado)]
@using APC.Core.Datos
@using APC.Core.Tenants
@inject SesionService SesionSrv
@inject NavigationManager Nav
@inject ReporteService ReporteSrv
@inject SucursalService SucursalSrv
@inject CatalogoService Catalogo
@inject IJSRuntime JS

<PageTitle>Reportes · Factu360</PageTitle>

<div class="page-pad">
    <header class="fact-head">
        <div class="fact-titulo">
            <h1>Reportes</h1>
            <span class="sub">@Periodo</span>
            @if (!cargando && resumen != null)
            {
                <span class="sub rep-detalle">Facturado @Pesos(resumen.TotalFacturas) · Notas de crédito −@Pesos(resumen.TotalNotasCredito) · Notas de pedido @Pesos(resumen.TotalNotasPedido) (@resumen.CantidadNotasPedido)</span>
            }
        </div>
        <div class="rep-chips">
            @foreach (var k in Chips)
            {
                <div class="rep-chip">
                    @if (cargando)
                    {
                        <span class="sk sk-oscuro sk-alto" style="width: 90px"></span>
                    }
                    else
                    {
                        <span class="rep-chip-num mono">@k.Valor</span>
                    }
                    <span class="rep-chip-txt">@k.Nombre</span>
                </div>
            }
        </div>
    </header>

    <div class="rep-barra">
        <div class="segmentos" role="group" aria-label="Período">
            @foreach (var r in Rangos)
            {
                <button type="button" class="segmento @(rango == r.Key ? "activo" : "")" aria-pressed="@(rango == r.Key ? "true" : "false")"
                        @onclick="() => Rango(r.Key)">@r.Value</button>
            }
        </div>
        <div class="campo campo-fecha"><label for="desde">Desde</label><input id="desde" class="input" type="date" @bind="desde" @bind:after="ElegirFechas" /></div>
        <div class="campo campo-fecha"><label for="hasta">Hasta</label><input id="hasta" class="input" type="date" @bind="hasta" @bind:after="ElegirFechas" /></div>
        @if (sucursales.Count > 1)
        {
            <div class="campo">
                <label for="sucursal">Sucursal</label>
                <select id="sucursal" class="input" @bind="puntoVentaTexto" @bind:after="Buscar">
                    <option value="">Todas las sucursales</option>
                    @foreach (var s in sucursales)
                    {
                        <option value="@s.PuntoVenta">@s.Nombre</option>
                    }
                </select>
            </div>
        }
        <button type="button" class="btn rep-exportar" @onclick="Exportar" disabled="@(cargando || resumen == null)"
                title="Descarga la tabla de la pestaña elegida abajo, en un archivo que Excel abre directamente">Exportar a Excel</button>
    </div>

    @if (error != null)
    {
        <p class="alerta alerta-error">@error</p>
    }

    <div class="rep-graficos">
        <section class="panel rep-dias" aria-labelledby="tit-dias">
            <h2 id="tit-dias">Ventas por día</h2>
            <p class="sub">@(porDia.Count > MaxDias ? $"Últimos {MaxDias} días con ventas" : "Días con ventas") del período: facturas con CAE y notas de pedido, con IVA.</p>
            @if (cargando)
            {
                <div class="rep-columnas" aria-busy="true">
                    @for (var i = 0; i < 12; i++)
                    {
                        <div class="rep-col"><span class="sk rep-sk-barra" style="height: @(40 + (i * 37) % 120)px"></span></div>
                    }
                </div>
            }
            else if (Dias.Count == 0)
            {
                <p class="vacio">Sin ventas en el período.</p>
            }
            else
            {
                <div class="rep-columnas" role="img" aria-label="Gráfico de barras de las ventas por día">
                    @for (var i = 0; i < Dias.Count; i++)
                    {
                        var d = Dias[i];
                        var ultimo = i == Dias.Count - 1;
                        <div class="rep-col" title="@d.Etiqueta · @Pesos(d.Total) · @d.Cantidad comprobantes">
                            <span class="rep-valor" style="animation-delay: @(i * 50 + 400)ms">@Corto(d.Total)</span>
                            <span class="rep-barra-col @(ultimo ? "ultima" : "")" style="height: @(Alto(d.Total))%; animation-delay: @(i * 50)ms"></span>
                            <span class="rep-dia">@DiaCorto(d.Etiqueta)</span>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="panel rep-pagos" aria-labelledby="tit-pagos">
            <h2 id="tit-pagos">Por forma de pago</h2>
            <p class="sub">Porcentaje sobre el total vendido en el período.</p>
            @if (cargando)
            {
                for (var i = 0; i < 5; i++)
                {
                    <div class="rep-pago"><span class="sk" style="width: 60%"></span><span class="sk" style="width: 100%; height: 10px"></span></div>
                }
            }
            else if (porFormaPago.Count == 0)
            {
                <p class="vacio">Sin ventas en el período.</p>
            }
            else
            {
                for (var i = 0; i < porFormaPago.Count; i++)
                {
                    var f = porFormaPago[i];
                    var pct = Porcentaje(f.Total);
                    <div class="rep-pago">
                        <div class="rep-pago-fila">
                            @if (EsMercadoPago(f.Etiqueta))
                            {
                                <span class="con-logo-mp"><img class="logo-mp" src="img/mercadopago-color.png" alt="Mercado Pago" /> QR</span>
                            }
                            else
                            {
                                <span class="fuerte">@f.Etiqueta</span>
                            }
                            <span class="mono">@Pesos(f.Total) <span class="sub">· @(pct.ToString("0", Ar)) %</span></span>
                        </div>
                        <div class="rep-pista"><span class="rep-relleno" style="width: @(pct.ToString("0.##", CultureInfo.InvariantCulture))%; background: @(ColorPago(f.Etiqueta, i)); animation-delay: @(i * 90)ms"></span></div>
                    </div>
                }
            }
        </section>
    </div>

    <section class="panel tabla-scroll rep-ultimos" aria-labelledby="tit-ultimos">
        <div class="entre fila-btns">
            <h2 id="tit-ultimos">Últimos comprobantes</h2>
            <a class="fuerte" href="/comprobantes">Ver todos →</a>
        </div>
        <table class="tabla">
            <thead><tr><th>Fecha</th><th>Comprobante</th><th>Cliente</th><th>Forma de pago</th><th>CAE</th><th class="der">Total</th></tr></thead>
            <tbody>
                @if (cargando)
                {
                    <FilasEsqueleto Filas="5" Columnas="6" />
                }
                else if (ultimos.Count == 0)
                {
                    <tr><td colspan="6" class="sub">Sin comprobantes en el período.</td></tr>
                }
                else
                {
                    foreach (var c in ultimos)
                    {
                        <tr>
                            <td class="mono">@c.Fecha.ToString("dd/MM HH:mm")</td>
                            <td class="fuerte">@(c.EsNotaPedido ? $"Nota de pedido {Nro(c.Terminal, c.NumeroInterno)}" : $"Factura {c.Tipo} {Nro(c.Terminal, c.Numero)}")</td>
                            <td>@(string.IsNullOrWhiteSpace(c.ClienteNombre) ? "Consumidor final" : c.ClienteNombre)</td>
                            <td>
                                @if (EsMercadoPago(c.FormaPago))
                                {
                                    <span class="etiqueta etiqueta-azul con-logo-mp"><img class="logo-mp" src="img/mercadopago-color.png" alt="Mercado Pago" /> QR</span>
                                }
                                else
                                {
                                    <span class="etiqueta etiqueta-azul">@(c.FormaPago ?? "—")</span>
                                }
                            </td>
                            <td>
                                @if (c.Anulada) { <span class="etiqueta etiqueta-rojo">Anulada</span> }
                                else if (c.EsNotaPedido) { <span class="etiqueta etiqueta-gris">Sin CAE</span> }
                                else { <span class="etiqueta etiqueta-ok">Autorizado</span> }
                            </td>
                            <td class="der fuerte mono">@Pesos(c.MontoTotal)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </section>

    @if (!cargando && resumen != null)
    {
        <section class="panel rep-detalles" aria-labelledby="tit-detalle">
            <h2 id="tit-detalle">Detalle del período</h2>
            <nav class="pestanias" aria-label="Tipo de reporte">
                @foreach (var p in Pestanias)
                {
                    <button type="button" class="pestania @(pestania == p.Key ? "activa" : "")" @onclick="() => pestania = p.Key">@p.Value</button>
                }
            </nav>

            <div class="tabla-scroll">
                @switch (pestania)
                {
                    case 0:
                        <table class="tabla">
                            <thead><tr><th>Día</th><th class="der">Comprobantes</th><th class="der">Total</th></tr></thead>
                            <tbody>
                                @if (porDia.Count == 0) { <tr><td colspan="3" class="sub">Sin ventas en el período.</td></tr> }
                                @foreach (var f in porDia)
                                {
                                    <tr><td>@f.Etiqueta</td><td class="der">@f.Cantidad</td><td class="der fuerte">@Pesos(f.Total)</td></tr>
                                }
                            </tbody>
                        </table>
                        break;

                    case 1:
                        <table class="tabla">
                            <thead><tr><th>Forma de pago</th><th class="der">Comprobantes</th><th class="der">Total</th></tr></thead>
                            <tbody>
                                @if (porFormaPago.Count == 0) { <tr><td colspan="3" class="sub">Sin ventas en el período.</td></tr> }
                                @foreach (var f in porFormaPago)
                                {
                                    <tr><td>@f.Etiqueta</td><td class="der">@f.Cantidad</td><td class="der fuerte">@Pesos(f.Total)</td></tr>
                                }
                            </tbody>
                        </table>
                        break;

                    case 2:
                        <table class="tabla">
                            <thead><tr><th>Usuario</th><th>Nombre</th><th class="der">Comprobantes</th><th class="der">Total</th></tr></thead>
                            <tbody>
                                @if (porUsuario.Count == 0) { <tr><td colspan="4" class="sub">Sin ventas en el período.</td></tr> }
                                @foreach (var f in porUsuario)
                                {
                                    <tr><td class="mono">@f.Etiqueta</td><td>@f.Detalle</td><td class="der">@f.Cantidad</td><td class="der fuerte">@Pesos(f.Total)</td></tr>
                                }
                            </tbody>
                        </table>
                        break;

                    case 3:
                        <table class="tabla">
                            <thead><tr><th>Código</th><th>Producto</th><th class="der">Cantidad</th><th class="der">Total</th></tr></thead>
                            <tbody>
                                @if (porProducto.Count == 0) { <tr><td colspan="4" class="sub">Sin ventas en el período.</td></tr> }
                                @foreach (var f in porProducto)
                                {
                                    <tr><td class="mono">@f.Codigo</td><td>@f.Producto</td><td class="der">@f.Cantidad.ToString("N3", Ar)</td><td class="der fuerte">@Pesos(f.Total)</td></tr>
                                }
                            </tbody>
                        </table>
                        break;

                    default:
                        @* Libro IVA Ventas: la pestaña sólo aparece si la empresa es responsable inscripto *@
                        <table class="tabla tabla-chica">
                            <thead>
                                <tr>
                                    <th>Fecha</th><th>Comprobante</th><th>Número</th><th>Cliente</th><th>CUIT</th>
                                    <th class="der">Neto gravado</th><th class="der">IVA 21%</th><th class="der">IVA 10,5%</th>
                                    <th class="der">IVA 27%</th><th class="der">No gravado</th><th class="der">Exento</th>
                                    <th class="der">Total</th><th>CAE</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (libro.Count == 0) { <tr><td colspan="13" class="sub">Sin comprobantes fiscales en el período.</td></tr> }
                                @foreach (var f in libro)
                                {
                                    <tr>
                                        <td>@f.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@f.Comprobante @f.Letra</td>
                                        <td class="mono">@f.NumeroCompleto</td>
                                        <td>@f.ClienteNombre</td>
                                        <td class="mono">@f.ClienteCUIT</td>
                                        <td class="der">@Numero(f.NetoGravado)</td>
                                        <td class="der">@Numero(f.Iva21)</td>
                                        <td class="der">@Numero(f.Iva105)</td>
                                        <td class="der">@Numero(f.Iva27)</td>
                                        <td class="der">@Numero(f.NoGravado)</td>
                                        <td class="der">@Numero(f.Exento)</td>
                                        <td class="der fuerte">@Numero(f.MontoTotal)</td>
                                        <td class="mono sub">@f.CAE</td>
                                    </tr>
                                }
                            </tbody>
                            @if (libro.Count > 0)
                            {
                                <tfoot>
                                    <tr class="fila-total">
                                        <td colspan="5">Totales</td>
                                        <td class="der">@Numero(libro.Sum(x => x.NetoGravado))</td>
                                        <td class="der">@Numero(libro.Sum(x => x.Iva21))</td>
                                        <td class="der">@Numero(libro.Sum(x => x.Iva105))</td>
                                        <td class="der">@Numero(libro.Sum(x => x.Iva27))</td>
                                        <td class="der">@Numero(libro.Sum(x => x.NoGravado))</td>
                                        <td class="der">@Numero(libro.Sum(x => x.Exento))</td>
                                        <td class="der">@Numero(libro.Sum(x => x.MontoTotal))</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                        break;
                }
            </div>
        </section>
    }
</div>

@code {
    private static readonly CultureInfo Ar = new("es-AR");

    /// <summary>Cuántas barras entran en el gráfico de ventas por día.</summary>
    private const int MaxDias = 31;

    private static readonly Dictionary<int, string> Rangos = new()
    {
        [0] = "Hoy",
        [1] = "Esta semana",
        [2] = "Este mes",
        [3] = "Mes anterior"
    };

    /// <summary>Pestañas del detalle. El Libro IVA Ventas sólo tiene sentido para un responsable inscripto.</summary>
    private Dictionary<int, string> Pestanias
    {
        get
        {
            var p = new Dictionary<int, string>
            {
                [0] = "Por día",
                [1] = "Por forma de pago",
                [2] = "Por usuario",
                [3] = "Por producto"
            };
            if (esResponsableInscripto) p[4] = "Libro IVA Ventas";
            return p;
        }
    }

    private SesionActual sesion;
    private DateTime desde = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime hasta = DateTime.Today;
    private int pestania;
    private int? rango = 2;   // el período arranca en "Este mes"; null = fechas elegidas a mano
    private bool esResponsableInscripto;
    private List<ComprobanteListado> ultimos = new();
    private bool cargando = true;
    private string error;

    private List<Sucursal> sucursales = new();
    private int? puntoVenta;

    private string puntoVentaTexto
    {
        get => puntoVenta?.ToString() ?? "";
        set => puntoVenta = int.TryParse(value, out var v) ? v : null;
    }

    private ResumenVentas resumen;
    private List<FilaReporte> porDia = new();
    private List<FilaReporte> porFormaPago = new();
    private List<FilaReporte> porUsuario = new();
    private List<FilaProducto> porProducto = new();
    private List<FilaLibroIva> libro = new();

    private string Periodo => $"Del {desde:dd/MM/yyyy} al {hasta:dd/MM/yyyy}" +
        (puntoVenta == null ? "" : " · " + (sucursales.FirstOrDefault(s => s.PuntoVenta == puntoVenta)?.Nombre ?? ""));

    protected override async Task OnInitializedAsync()
    {
        sesion = await SesionSrv.ObtenerAsync();
        // Lo que ve cada rol lo configura CM Tech en Empresas → Módulos.
        if (!sesion.TieneModulo(Modulo.Reportes)) { Nav.NavigateTo("/sin-permiso"); return; }
        try { esResponsableInscripto = (await Catalogo.EmpresaAsync(sesion.Cs))?.EsResponsableInscripto == true; }
        catch (Exception) { esResponsableInscripto = false; }
        try { sucursales = await SucursalSrv.ListarAsync(sesion.Cs, incluirInactivas: false); }
        catch (Exception) { sucursales = new(); }   // la empresa todavía no corrió el script de sucursales
        await Buscar();
    }

    private async Task ElegirFechas()
    {
        rango = null;
        await Buscar();
    }

    private async Task Rango(int cual)
    {
        rango = cual;
        var hoy = DateTime.Today;
        switch (cual)
        {
            case 0: desde = hoy; hasta = hoy; break;
            case 1: desde = hoy.AddDays(-(int)hoy.DayOfWeek + (hoy.DayOfWeek == DayOfWeek.Sunday ? -6 : 1)); hasta = hoy; break;
            case 2: desde = new DateTime(hoy.Year, hoy.Month, 1); hasta = hoy; break;
            default:
                var mesAnterior = new DateTime(hoy.Year, hoy.Month, 1).AddMonths(-1);
                desde = mesAnterior;
                hasta = mesAnterior.AddMonths(1).AddDays(-1);
                break;
        }
        await Buscar();
    }

    private async Task Buscar()
    {
        cargando = true;
        error = null;
        StateHasChanged();
        try
        {
            if (hasta < desde) (desde, hasta) = (hasta, desde);
            resumen = await ReporteSrv.ResumenAsync(sesion.Cs, desde, hasta, puntoVenta);
            porDia = await ReporteSrv.PorDiaAsync(sesion.Cs, desde, hasta, puntoVenta);
            porFormaPago = await ReporteSrv.PorFormaPagoAsync(sesion.Cs, desde, hasta, puntoVenta);
            porUsuario = await ReporteSrv.PorUsuarioAsync(sesion.Cs, desde, hasta, puntoVenta);
            porProducto = await ReporteSrv.PorProductoAsync(sesion.Cs, desde, hasta, puntoVenta);
            ultimos = await ReporteSrv.UltimosAsync(sesion.Cs, desde, hasta, puntoVenta);
            libro = esResponsableInscripto
                ? await ReporteSrv.LibroIvaVentasAsync(sesion.Cs, desde, hasta, puntoVenta)
                : new();
        }
        catch (Exception ex)
        {
            error = "No se pudieron leer los datos: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Exportar()
    {
        var (nombre, bytes) = Archivo();
        await JS.InvokeVoidAsync("apc.descargar", nombre, Convert.ToBase64String(bytes), "text/csv");
    }

    private (string Nombre, byte[] Contenido) Archivo()
    {
        var sufijo = $"{desde:yyyy-MM-dd}_a_{hasta:yyyy-MM-dd}.csv";
        switch (pestania)
        {
            case 0:
                return ("Ventas por dia " + sufijo, Csv.Armar(
                    new[] { "Día", "Comprobantes", "Total" },
                    porDia.Select(f => new object[] { f.Etiqueta, f.Cantidad, f.Total })));
            case 1:
                return ("Ventas por forma de pago " + sufijo, Csv.Armar(
                    new[] { "Forma de pago", "Comprobantes", "Total" },
                    porFormaPago.Select(f => new object[] { f.Etiqueta, f.Cantidad, f.Total })));
            case 2:
                return ("Ventas por usuario " + sufijo, Csv.Armar(
                    new[] { "Usuario", "Nombre", "Comprobantes", "Total" },
                    porUsuario.Select(f => new object[] { f.Etiqueta, f.Detalle, f.Cantidad, f.Total })));
            case 3:
                return ("Ventas por producto " + sufijo, Csv.Armar(
                    new[] { "Código", "Producto", "Cantidad", "Total" },
                    porProducto.Select(f => new object[] { f.Codigo, f.Producto, f.Cantidad, f.Total })));
            default:
                return ("Libro IVA Ventas " + sufijo, Csv.Armar(
                    new[] { "Fecha", "Comprobante", "Letra", "Cód. AFIP", "Número", "Cliente", "CUIT", "Condición IVA",
                            "Neto gravado", "IVA 21%", "IVA 10,5%", "IVA 27%", "No gravado", "Exento", "Total", "CAE" },
                    libro.Select(f => new object[]
                    {
                        f.Fecha, f.Comprobante, f.Letra, f.TipoComprobanteAFIP, f.NumeroCompleto, f.ClienteNombre,
                        f.ClienteCUIT, f.CondicionIva, f.NetoGravado, f.Iva21, f.Iva105, f.Iva27,
                        f.NoGravado, f.Exento, f.MontoTotal, f.CAE
                    })));
        }
    }

    // ---------- encabezado ----------
    private record Chip(string Nombre, string Valor);

    private IEnumerable<Chip> Chips
    {
        get
        {
            var r = resumen ?? new ResumenVentas();
            var promedio = r.CantidadFacturas > 0 ? r.VentasNetas / r.CantidadFacturas : 0;
            yield return new Chip("Vendido", PesosCorto(r.VentasNetas));
            yield return new Chip("Comprobantes", r.CantidadFacturas.ToString("N0", Ar));
            yield return new Chip("Ticket promedio", "$ " + promedio.ToString("N0", Ar));
            yield return esResponsableInscripto
                ? new Chip("IVA débito", PesosCorto(r.IvaNeto))
                : new Chip("Notas de pedido", PesosCorto(r.TotalNotasPedido));
        }
    }

    // ---------- gráfico de ventas por día ----------
    private List<FilaReporte> Dias => porDia.Count > MaxDias ? porDia.Skip(porDia.Count - MaxDias).ToList() : porDia;

    /// <summary>Alto de la barra en % del más alto del gráfico (mínimo 2 % para que se vea).</summary>
    private decimal Alto(decimal total)
    {
        var max = Dias.Count == 0 ? 0 : Dias.Max(d => d.Total);
        if (max <= 0) return 0;
        return Math.Round(Math.Max(2m, total * 100m / max), 1);
    }

    /// <summary>"dd/MM/yyyy" → "dd/MM".</summary>
    private static string DiaCorto(string etiqueta) => etiqueta?.Length >= 5 ? etiqueta[..5] : etiqueta;

    /// <summary>Importe corto para arriba de cada barra: 318k, 1,2M.</summary>
    private static string Corto(decimal v) =>
        v >= 1_000_000m ? (v / 1_000_000m).ToString("0.#", Ar) + "M"
        : v >= 1_000m ? (v / 1_000m).ToString("0", Ar) + "k"
        : v.ToString("0", Ar);

    private static string PesosCorto(decimal v) =>
        v >= 1_000_000m ? "$ " + (v / 1_000_000m).ToString("0.00", Ar) + " M" : "$ " + v.ToString("N0", Ar);

    // ---------- formas de pago ----------
    private decimal Porcentaje(decimal total)
    {
        var suma = porFormaPago.Sum(f => f.Total);
        return suma <= 0 ? 0 : Math.Round(total * 100m / suma, 2);
    }

    private static bool EsMercadoPago(string nombre) =>
        nombre != null && nombre.Contains("mercado pago", StringComparison.OrdinalIgnoreCase);

    private static readonly string[] Colores = { "#16A34A", "#2F7BF5", "#7C3AED", "#F26B1D", "#0EA5E9", "#64748B" };

    /// <summary>Mercado Pago va con su celeste; el resto toma un color de la paleta.</summary>
    private static string ColorPago(string nombre, int i) => EsMercadoPago(nombre) ? "#00BCFF" : Colores[i % Colores.Length];

    private static string Nro(int terminal, int? numero) => $"{terminal:0000}-{(numero ?? 0):00000000}";

    private static string Pesos(decimal v) => "$ " + v.ToString("N2", Ar);
    private static string Numero(decimal v) => v == 0 ? "—" : v.ToString("N2", Ar);
}
