    /// <summary>Por qué el botón de emitir está deshabilitado (null si se puede emitir o no hay nada cargado).</summary>
    private string MotivoNoEmitir =>
        emitiendo || factura.Renglones.Count == 0 ? null :
        turno == null && ExigeCaja ? (sesion.Caja != null ? sesion.Caja.TituloCaja + " está cerrada" : "La caja está cerrada") + ": abrila en Arqueo para poder facturar." :
        formasPago.Count == 0 ? "No hay formas de pago cargadas en esta empresa. Pedile a CM Tech que las configure." :
        formaPago == null ? "Elegí la forma de pago." :
        FaltanPrecios ? "Hay renglones sin precio. Escribilo en el renglón marcado." :
        formaPago.EsEfectivo && pagaCon > 0 && pagaCon < totales.Total ? "El monto con el que paga no alcanza." :
        null;

    private bool FaltanPrecios => factura.Renglones.Any(r => r.PrecioUnitario <= 0);

    private void CambiarCantidad(RenglonCarrito r, decimal delta)
    {
        r.Cantidad = Math.Max(0, r.Cantidad + delta);
        if (r.Cantidad == 0) factura.Renglones.Remove(r);
        Recalcular();
    }

    private void SetCantidad(RenglonCarrito r, string valor)
    {
        if (decimal.TryParse(valor, NumberStyles.Number, CultureInfo.InvariantCulture, out var c) && c >= 0)
        {
            r.Cantidad = c;
            if (c == 0) factura.Renglones.Remove(r);
        }
        Recalcular();
    }

    private void Quitar(RenglonCarrito r) { factura.Renglones.Remove(r); Recalcular(); }

    private void ElegirPago(FormaPagoItem fp) { AplicarFormaPago(fp); if (!fp.EsEfectivo) pagaCon = 0; Recalcular(); }

    /// <summary>Como SetRecargo de APC: la forma de pago propone el descuento o recargo sobre el total (se puede cambiar a mano).</summary>
    private void AplicarFormaPago(FormaPagoItem fp)
    {
        formaPago = fp;
        factura.DescuentoTotalPorc = fp?.PorcentajeDescuento ?? 0;
        factura.RecargoTotalPorc = fp?.PorcentajeRecargo ?? 0;
    }

    private void ToggleCliente() => verCliente = !verCliente;

    private void Recalcular() =>
        totales = FacturacionService.CalcularTotales(factura, param.General, param.Diferenciada, empresa.EsMonotributo);

    /// <param name="formato">"ticket" (80 mm), "a4", o null para guardar sin imprimir.</param>
    /// <param name="fiscal">false = nota de pedido (no fiscal, sin CAE).</param>
    private async Task Emitir(string formato, bool fiscal = true)
    {
        if (!PuedeEmitir) return;
        // Con QR primero se cobra: la factura se emite recién cuando Mercado Pago acredita el pago.
        if (formaPago?.EsMercadoPago == true && pagoQr?.Pagado != true)
        {
            await IniciarCobroQr(formato, fiscal);
            return;
        }
        // Con el QR del comercio el pago no se puede consultar: lo confirma el cajero.
        if (formaPago?.EsQrPropio == true && !mostrandoQrPropio)
        {
            await MostrarQrPropio(formato, fiscal);
            return;
        }
        await EmitirAhora(formato, fiscal);
    }

    private async Task EmitirAhora(string formato, bool fiscal)
    {
        emitiendo = true;
        resultado = null;
        StateHasChanged();
        try
        {
            // La caja puede ser compartida: otro cajero pudo haberla cerrado mientras se cargaba el comprobante.
            if (ExigeCaja && turno?.EsDeCaja == true)
            {
                turno = await Caja.TurnoAbiertoAsync(sesion.Cs, sesion.UsuarioId, sesion.Caja?.CajaId);
                // Sin turno aparece el aviso "caja cerrada" y el botón de emitir queda deshabilitado.
                if (turno == null) return;
            }
            factura.FormaPagoId = formaPago.Id;
            resultado = await Facturacion.EmitirAsync(sesion.Tenant, sesion.UsuarioId, factura, fiscal, sesion.Sucursal);
            // Con o sin CAE: el cliente (traído de ARCA o cargado a mano) queda en el fichero de clientes.
            if (resultado.FacturaId != null)
            {
                try { await ClienteSrv.GuardarDesdeComprobanteAsync(sesion.Cs, factura, resultado.FacturaId.Value); }
                catch (Exception) { /* no frena la venta */ }
            }
            if (resultado.FacturaId != null && presupuestoOrigenId != null)
            {
                await Presupuestos.MarcarFacturadoAsync(sesion.Cs, presupuestoOrigenId.Value);
                presupuestoOrigenId = null;
                presupuestoOrigen = null;
            }
            if (resultado.Ok && resultado.FacturaId != null && formato != null)
                await JS.InvokeVoidAsync("apc.imprimir", $"/imprimir/{resultado.FacturaId}?formato={formato}");
        }
        catch (Exception ex)
        {
            resultado = new ResultadoEmision { Ok = false, Mensaje = "Error inesperado: " + ex.Message };
        }
        finally
        {
            emitiendo = false;
        }
    }

    // ------------------------------------------------------------------ consulta de precio

    [JSInvokable] public async Task AtajoConsulta()
    {
        if (pagoQr != null || qrOcupado || mostrandoQrPropio) return;
        await AbrirConsulta();
    }

    private async Task AbrirConsulta()
    {
        consultando = true;
        textoConsulta = "";
        consultaResultados.Clear();
        consultaElegido = null;
        consultaSinResultados = false;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("apc.enfocar", "buscar-consulta");
    }

    private async Task CerrarConsulta()
    {
        consultando = false;
        await JS.InvokeVoidAsync("apc.enfocar", "buscar");
    }

    private async Task ConsultaKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { await CerrarConsulta(); return; }
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(textoConsulta)) return;

        consultaElegido = null;
        consultaResultados = await Catalogo.BuscarProductosAsync(sesion.Cs, textoConsulta.Trim());
        consultaSinResultados = consultaResultados.Count == 0;
        if (consultaResultados.Count == 1) consultaElegido = consultaResultados[0];
    }

    /// <summary>Formas de pago que cambian el precio: son las que el cliente quiere comparar.</summary>
    private List<FormaPagoItem> FormasConAjuste =>
        formasPago.Where(f => !f.EsCtaCte && (f.PorcentajeRecargo != 0 || f.PorcentajeDescuento != 0)).ToList();

    private static decimal PrecioCon(ProductoItem p, FormaPagoItem fp) =>
        Math.Round(p.PrecioVenta1 * (1 + fp.PorcentajeRecargo / 100m - fp.PorcentajeDescuento / 100m), 2);

    private async Task AgregarDesdeConsulta(ProductoItem p)
    {
        consultando = false;
        await Agregar(p, 1);
    }

    // ------------------------------------------------------------------ cobro con el QR del comercio

    private async Task MostrarQrPropio(string formato, bool fiscal)
    {
        qrPropioFormato = formato;
        qrPropioFiscal = fiscal;
        mostrandoQrPropio = true;
        StateHasChanged();
        try
        {
            if (qrPropioUri == null && sesion.Sucursal != null)
                qrPropioUri = await SucursalSrv.QrDataUriAsync(sesion.Cs, sesion.Sucursal.Id);
        }
        catch { qrPropioUri = null; }
    }

    /// <summary>Completa el tiempo mínimo para que un cartel no aparezca y desaparezca de golpe.</summary>
    private static async Task EsperarLoQueFalte(System.Diagnostics.Stopwatch reloj)
    {
        var falta = EsperaMinimaFacturaMs - (int)reloj.ElapsedMilliseconds;
        if (falta > 0) await Task.Delay(falta);
    }

    private async Task ConfirmarQrPropio()
    {
        qrPropioFacturando = true;
        StateHasChanged();
        var reloj = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            await EmitirAhora(qrPropioFormato, qrPropioFiscal);
            await EsperarLoQueFalte(reloj);
        }
        finally
        {
            qrPropioFacturando = false;
            mostrandoQrPropio = false;
        }
    }

    private void CerrarQrPropio() => mostrandoQrPropio = false;

    // ------------------------------------------------------------------ cobro con QR

    // ---- caja de Mercado Pago de esta computadora (si la sucursal tiene varias) ----
    private List<MercadoPagoCaja> mpCajasSucursal;
    private string mpCajaElegida = "";

    private string ClaveCajaMp => $"factu360.cajaMp.{sesion.Tenant.Id}.{sesion.PuntoVenta}";

    private Guid? CajaMpElegida => Guid.TryParse(mpCajaElegida, out var id) ? id : null;

    private Guid? cajaDeLasMp;   // caja del usuario con la que se cargó la lista (si cambia de caja, se vuelve a cargar)

    private async Task CargarCajasMpAsync()
    {
        if (mpCajasSucursal != null && cajaDeLasMp == sesion.Caja?.CajaId) return;
        cajaDeLasMp = sesion.Caja?.CajaId;
        try
        {
            mpCajasSucursal = (await MpSrv.CajasAsync(sesion.Tenant.Id))
                .Where(c => c.PuntoVenta == sesion.PuntoVenta && c.Creada).ToList();
        }
        catch (Exception) { mpCajasSucursal = new(); }

        // Si el usuario eligió su caja al ingresar y esa caja está vinculada a una de Mercado Pago,
        // cobra siempre con esa: no hay nada que elegir.
        var vinculada = sesion.Caja?.MercadoPagoCajaId;
        if (vinculada != null && mpCajasSucursal.Any(c => c.Id == vinculada))
        {
            mpCajasSucursal = mpCajasSucursal.Where(c => c.Id == vinculada).ToList();
            mpCajaElegida = vinculada.ToString();
            return;
        }

        try { mpCajaElegida = await JS.InvokeAsync<string>("localStorage.getItem", ClaveCajaMp) ?? ""; }
        catch (Exception) { mpCajaElegida = ""; }
        if (!mpCajasSucursal.Any(c => c.Id.ToString() == mpCajaElegida))
            mpCajaElegida = mpCajasSucursal.FirstOrDefault()?.Id.ToString() ?? "";
    }

    /// <summary>Cambió la caja: se recuerda en esta computadora y se vuelve a generar el cobro en la nueva.</summary>
    private async Task CambiarCajaMp()
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", ClaveCajaMp, mpCajaElegida); } catch (Exception) { }
        await CerrarQr();   // cancela la order que quedó en la otra caja
        await IniciarCobroQr(qrFormato, qrFiscal);
    }

    private async Task IniciarCobroQr(string formato, bool fiscal)
    {
        qrFormato = formato;
        qrFiscal = fiscal;
        qrError = null;
        qrImagen = null;
        qrFijo = false;
        qrPaso = null;
        pagoQr = null;
        qrOcupado = true;
        StateHasChanged();
        try
        {
            await CargarCajasMpAsync();
            var (orden, pago) = await MpSrv.CobrarAsync(
                sesion.Tenant, sesion.Sucursal, sesion.UsuarioId, totales.Total, DescripcionCobro(), CajaMpElegida);
            pagoQr = pago;
            if (!orden.Ok) { qrError = orden.Mensaje; return; }

            qrFijo = orden.Fijo;
            qrImagen = orden.Fijo
                ? orden.QrImagen
                : FacturacionService.QrDataUri(orden.QrData);
            EsperarPago();
        }
        catch (Exception ex)
        {
            qrError = "No se pudo generar el QR: " + ex.Message;
        }
        finally
        {
            qrOcupado = false;
        }
    }

    private string DescripcionCobro()
    {
        var primero = factura.Renglones.FirstOrDefault()?.Producto?.Nombre ?? "Venta";
        return factura.Renglones.Count > 1 ? $"{primero} y {factura.Renglones.Count - 1} más" : primero;
    }

    /// <summary>Le pregunta a Mercado Pago cada 3 segundos hasta que el pago se acredita o se vence.</summary>
    private void EsperarPago()
    {
        DetenerEspera();
        qrCts = new CancellationTokenSource();
        var ct = qrCts.Token;
        var id = pagoQr.Id;
        _ = Task.Run(async () =>
        {
            try
            {
                while (!ct.IsCancellationRequested)
                {
                    await Task.Delay(3000, ct);
                    var p = await MpSrv.RefrescarAsync(sesion.Tenant, id);
                    if (ct.IsCancellationRequested) return;
                    var listo = p != null && p.Estado != EstadoPagoQr.Creada;
                    await InvokeAsync(async () =>
                    {
                        if (pagoQr?.Id != id) return;
                        pagoQr = p;
                        if (!listo) { StateHasChanged(); return; }
                        if (p.Pagado) await EmitirConQr();
                        else { qrError = MensajeEstado(p); StateHasChanged(); }
                    });
                    if (listo) return;
                }
            }
            catch (OperationCanceledException) { }
            catch (Exception ex)
            {
                try { await InvokeAsync(() => { qrError = ex.Message; StateHasChanged(); }); } catch { }
            }
        });
    }

    private void DetenerEspera()
    {
        try { qrCts?.Cancel(); } catch { }
        qrCts?.Dispose();
        qrCts = null;
    }

    private static string MensajeEstado(PagoQr p) => p.Estado switch
    {
        EstadoPagoQr.Vencida => "El QR se venció. Volvé a generarlo.",
        EstadoPagoQr.Cancelada => "El cobro se canceló.",
        _ => "Mercado Pago rechazó el pago. " + (p.Detalle ?? "")
    };

    private async Task VerificarQr()
    {
        if (pagoQr == null) return;
        qrOcupado = true;
        StateHasChanged();
        try
        {
            var p = await MpSrv.RefrescarAsync(sesion.Tenant, pagoQr.Id);
            if (p == null) return;
            pagoQr = p;
            if (p.Pagado) { qrOcupado = false; await EmitirConQr(); return; }
            if (p.Estado != EstadoPagoQr.Creada) qrError = MensajeEstado(p);
            else qrError = null;
        }
        catch (Exception ex) { qrError = ex.Message; }
        finally { qrOcupado = false; }
    }

    /// <summary>El pago se acreditó: se cierra el QR, se emite la factura y se la asocia al cobro.</summary>
    private async Task EmitirConQr()
    {
        var formato = qrFormato;
        var fiscal = qrFiscal;
        var pagoId = pagoQr?.Id;
        DetenerEspera();

        // Primero se ve que la plata entró; recién después se pide el CAE.
        qrPaso = PasoPagado;
        StateHasChanged();
        await Task.Delay(EsperaPagadoMs);

        qrPaso = PasoFacturando;
        StateHasChanged();
        var reloj = System.Diagnostics.Stopwatch.StartNew();
        await EmitirAhora(formato, fiscal);
        await EsperarLoQueFalte(reloj);

        if (pagoId != null && resultado?.FacturaId != null)
        {
            try { await MpSrv.AsociarFacturaAsync(sesion.Cs, pagoId.Value, resultado.FacturaId.Value); } catch { }
        }

        qrPaso = null;
        pagoQr = null;
        qrImagen = null;
        qrError = null;
        StateHasChanged();
    }

    private async Task CerrarQr()
    {
        var id = pagoQr?.Id;
        var pendiente = pagoQr != null && pagoQr.Estado == EstadoPagoQr.Creada;
        DetenerEspera();
        pagoQr = null;
        qrImagen = null;
        qrError = null;
        qrPaso = null;
        qrOcupado = false;
        if (pendiente && id != null)
        {
            try { await MpSrv.CancelarAsync(sesion.Tenant, id.Value); } catch { }
        }
    }

    private async Task Reimprimir(string formato) =>
        await JS.InvokeVoidAsync("apc.imprimir", $"/imprimir/{resultado.FacturaId}?formato={formato}");

    private async Task CargarPresupuesto(Guid id)
    {
        var f = await Presupuestos.ACarritoAsync(sesion.Cs, id);
        if (f == null) return;
        factura = f;
        editandoPrecio.Clear();
        pagaCon = 0;
        verCliente = !string.IsNullOrWhiteSpace(f.ClienteDocumento);
        formaPago = formasPago.FirstOrDefault(x => x.Id == f.FormaPagoId) ?? formasPago.FirstOrDefault(x => x.EsEfectivo) ?? formasPago.FirstOrDefault();
        presupuestoOrigenId = id;
        presupuestoOrigen = f.Observaciones?.Replace("Presupuesto Nº ", "");
        Recalcular();
    }

    private async Task Reintentar()
    {
        if (resultado?.FacturaId == null) return;
        emitiendo = true;
        StateHasChanged();
        try { resultado = await Facturacion.SolicitarCaeAsync(sesion.Tenant, resultado.FacturaId.Value); }
        finally { emitiendo = false; }
    }

    private void Nueva()
    {
        presupuestoOrigenId = null;
        presupuestoOrigen = null;
        factura = new NuevaFactura();
        telefonoWhatsApp = null;
        editandoPrecio.Clear();
        resultado = null;
        pagaCon = 0;
        verCliente = false;
        ultimoAgregado = null;
        confirmarCancelar = false;
        mostrandoQrPropio = false;
        qrPaso = null;
        DetenerEspera();
        pagoQr = null;
        qrImagen = null;
        qrError = null;
        AplicarFormaPago(formasPago.FirstOrDefault(f => f.EsEfectivo) ?? formasPago.FirstOrDefault());
        Recalcular();
        _ = JS.InvokeVoidAsync("apc.enfocar", "buscar");
    }

    private string EtiquetaIva(ProductoItem p) =>
        empresa.EsMonotributo ? "" :
        p.IvaExento ? "No gravado" :
        p.IvaDiferenciado ? $"IVA {param.Diferenciada.ToString("0.##", Ar)}%" : $"IVA {param.General.ToString("0.##", Ar)}%";

    private static string Pesos(decimal v) => "$ " + v.ToString("N2", Ar);

    public async ValueTask DisposeAsync()
    {
        DetenerEspera();
        try { await JS.InvokeVoidAsync("apc.quitarAtajos"); } catch { }
        refJs?.Dispose();
    }
}
