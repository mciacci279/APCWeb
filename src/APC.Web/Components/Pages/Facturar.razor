@page "/"
@attribute [Authorize(Roles = SesionService.RolEmpleado)]
@implements IAsyncDisposable
@using APC.Core.Tenants
@inject SesionService SesionSrv
@inject CatalogoService Catalogo
@inject FacturacionService Facturacion
@inject CajaService Caja
@inject PresupuestoService Presupuestos
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject APC.Core.Tenants.TenantRegistry Tenants
@inject MercadoPagoService MpSrv

<PageTitle>Facturar · APC Web</PageTitle>

@if (cargando)
{
    <div class="page-pad"><p>Cargando…</p></div>
}
else if (errorCarga != null)
{
    <div class="page-pad"><p class="alerta alerta-error">@errorCarga</p></div>
}
else
{
<div class="fact">
    <main class="fact-main">
        <header class="fact-head">
            <div class="fact-titulo">
                <h1>Factura @Letra</h1>
                <span class="sub">@(sesion.Sucursal != null ? sesion.Sucursal.Nombre + " · " : "")Pto. Vta. @sesion.PuntoVenta.ToString("0000") · @(string.IsNullOrWhiteSpace(factura.ClienteNombre) ? "Consumidor final" : factura.ClienteNombre)</span>
            </div>
            <div class="fila-btns">
                @if (!empresa.EsMonotributo)
                {
                    <label class="sr-only" for="condicion">Condición frente al IVA del cliente</label>
                    <select id="condicion" class="input" @bind="factura.Condicion" @bind:after="Recalcular">
                        <option value="@CondicionReceptor.ConsumidorFinal">Consumidor final</option>
                        <option value="@CondicionReceptor.ResponsableInscripto">Resp. inscripto (A)</option>
                        <option value="@CondicionReceptor.Monotributo">Monotributo</option>
                        <option value="@CondicionReceptor.Exento">Exento</option>
                    </select>
                }
                <button type="button" class="btn" @onclick="ToggleCliente">Cliente…  F3</button>
            </div>
        </header>

        @if (turno == null && ExigeCaja)
        {
            <p class="alerta alerta-aviso">La caja está cerrada. <a href="/arqueo">Abrí la caja</a> para poder facturar.</p>
        }

        @if (presupuestoOrigen != null && resultado == null)
        {
            <p class="alerta alerta-presu">Facturando el presupuesto Nº @presupuestoOrigen. Al emitir, el presupuesto queda marcado como facturado.</p>
        }

        @if (verCliente)
        {
            <DatosCliente Datos="factura" OnCambio="Recalcular" Deshabilitado="@(resultado != null)" />
        }

        <div class="buscador">
            <label class="sr-only" for="buscar">Buscar producto</label>
            <input id="buscar" class="input input-buscar" placeholder="Código de barras o descripción  (F2) · 3*código para cantidad"
                   autocomplete="off" disabled="@((turno == null && ExigeCaja) || resultado != null)"
                   @bind="textoBusqueda" @bind:event="oninput" @onkeydown="BuscarKey" />
            @if (resultados.Count > 0)
            {
                <ul class="resultados" role="listbox" aria-label="Resultados">
                    @foreach (var p in resultados)
                    {
                        <li>
                            <button type="button" class="resultado" @onclick="() => Agregar(p, cantidadBusqueda)">
                                <span class="r-nombre">@p.Nombre</span>
                                <span class="r-cod">@p.Codigo</span>
                                <span class="r-precio">@Pesos(p.PrecioVenta1)</span>
                            </button>
                        </li>
                    }
                </ul>
            }
            else if (sinResultados)
            {
                <p class="sub">No se encontró «@ultimaBusqueda».</p>
            }
        </div>

        <div class="renglones">
            @if (factura.Renglones.Count == 0)
            {
                <p class="vacio">Escaneá o buscá un producto para empezar.</p>
            }
            @foreach (var r in factura.Renglones)
            {
                <div class="renglon @(r == ultimoAgregado ? "activo" : "")">
                    <div class="r-info">
                        <span class="r-nombre">@r.Producto.Nombre</span>
                        <span class="sub">@r.Producto.Codigo · @EtiquetaIva(r.Producto)</span>
                    </div>
                    <div class="cantidad">
                        <button type="button" class="btn-cant" aria-label="Restar uno" @onclick="() => CambiarCantidad(r, -1)">−</button>
                        <label class="sr-only" for="cant-@r.Clave">Cantidad</label>
                        <input id="cant-@r.Clave" class="input-cant" type="number" step="0.001" min="0"
                               value="@r.Cantidad.ToString(CultureInfo.InvariantCulture)"
                               @onchange="e => SetCantidad(r, e.Value?.ToString())" />
                        <button type="button" class="btn-cant" aria-label="Sumar uno" @onclick="() => CambiarCantidad(r, 1)">+</button>
                    </div>
                    @if (r.PrecioLibre || editandoPrecio.Contains(r.Clave))
                    {
                        <div class="precio-libre">
                            <label class="sr-only" for="pu-@r.Clave">Precio unitario de @r.Producto.Nombre</label>
                            <span aria-hidden="true">$</span>
                            <input id="pu-@r.Clave" class="input-precio mono @(r.PrecioUnitario <= 0 ? "falta" : "")" type="number"
                                   step="0.01" min="0" placeholder="Precio"
                                   value="@(r.PrecioUnitario > 0 ? r.PrecioUnitario.ToString(CultureInfo.InvariantCulture) : "")"
                                   @onchange="e => SetPrecio(r, e.Value?.ToString())"
                                   @onkeydown="PrecioKey" />
                        </div>
                    }
                    else
                    {
                        <button type="button" class="r-pu btn-pu" title="Cambiar el precio solo en esta factura"
                                @onclick="() => EditarPrecio(r)">@Pesos(r.PrecioUnitario) c/u</button>
                    }
                    <AjusteRenglon Renglon="r" Deshabilitado="@(resultado != null)" OnCambio="Recalcular" />
                    <span class="r-total">@Pesos(FacturacionService.CalcularRenglon(r, factura).Monto)</span>
                    <button type="button" class="btn-quitar" aria-label="Quitar renglón" @onclick="() => Quitar(r)">×</button>
                </div>
            }
        </div>

        @if (factura.Renglones.Count > 0 && resultado == null)
        {
            <div class="campo campo-obs">
                <label for="obs">Observaciones</label>
                <textarea id="obs" class="input input-area" rows="2" maxlength="500" @bind="factura.Observaciones"
                          placeholder="ej. garantía 12 meses, nº de serie, condiciones"></textarea>
            </div>
        }
    </main>

    <aside class="ticket" aria-label="Cobro">
        <div class="t-fila sub-claro"><span>@sesion.Nombre</span><span>@EstadoCaja</span></div>

        @if (resultado != null && resultado.Ok)
        {
            <div class="t-exito" role="status">
                @if (resultado.EsNotaPedido)
                {
                    <span class="t-exito-tit">Nota de pedido emitida</span>
                    <span class="mono">Nº @resultado.Numero.ToString("00000000")</span>
                    <span class="sub-claro">Sin CAE</span>
                }
                else
                {
                    <span class="t-exito-tit">Factura emitida</span>
                    <span class="mono">@resultado.Letra @resultado.PuntoVenta.ToString("00000")-@resultado.Numero.ToString("00000000")</span>
                    <span class="sub-claro">CAE @resultado.Cae</span>
                }
            </div>
            <div class="t-pagos">
                <button type="button" class="btn-pago" @onclick="@(() => Reimprimir("ticket"))">Reimprimir ticket</button>
                <button type="button" class="btn-pago" @onclick="@(() => Reimprimir("a4"))">Reimprimir A4</button>
            </div>
            <div class="campo">
                <label for="wa-tel" class="sub-claro">Enviar por WhatsApp</label>
                <div class="wa-fila">
                    <input id="wa-tel" class="input-oscuro wa-tel mono" inputmode="tel" placeholder="Celular con característica, sin 0 ni 15"
                           @bind="telefonoWhatsApp" @bind:event="oninput" />
                    <a class="btn-whatsapp" href="@LinkWhatsApp" target="_blank" rel="noopener">WhatsApp</a>
                </div>
                <span class="sub-claro">Se abre WhatsApp con el mensaje y el link al comprobante. Sin número, elegís el contacto ahí.</span>
            </div>
            @if (vuelto > 0)
            {
                <div class="t-vuelto"><span>Vuelto</span><span class="mono">@Pesos(vuelto)</span></div>
            }
            <div class="t-spacer"></div>
            <button type="button" class="btn-emitir" @onclick="Nueva">Nueva factura  ·  Enter</button>
        }
        else
        {
            <div class="t-filas">
                @if (totales.MontoDescuento > 0)
                {
                    <div class="t-fila t-fila-desc"><span>Descuentos</span><span>− @Pesos(totales.MontoDescuento)</span></div>
                }
                @if (totales.MontoRecargo > 0)
                {
                    <div class="t-fila t-fila-rec"><span>Recargos</span><span>+ @Pesos(totales.MontoRecargo)</span></div>
                }
                @if (!empresa.EsMonotributo)
                {
                    <div class="t-fila"><span>Neto gravado</span><span>@Pesos(totales.Neto)</span></div>
                    <div class="t-fila"><span>IVA</span><span>@Pesos(totales.Iva)</span></div>
                    @if (totales.NoGravado > 0)
                    {
                        <div class="t-fila"><span>No gravado</span><span>@Pesos(totales.NoGravado)</span></div>
                    }
                }
            </div>
            <div class="t-total">
                <span class="sub-claro">Total a cobrar</span>
                <span class="mono t-total-num">@Pesos(totales.Total)</span>
            </div>

            <div class="t-pagos">
                @foreach (var fp in formasPago)
                {
                    <button type="button" class="btn-pago @(formaPago?.Id == fp.Id ? "activo" : "")" title="@(string.IsNullOrWhiteSpace(fp.TipoPrecio) ? "Precio de lista" : fp.TipoPrecio)" @onclick="() => ElegirPago(fp)">@fp.Nombre@(fp.PorcentajeRecargo > 0 ? $" (+{fp.PorcentajeRecargo.ToString("0.##", Ar)} %)" : fp.PorcentajeDescuento > 0 ? $" (−{fp.PorcentajeDescuento.ToString("0.##", Ar)} %)" : "")</button>
                }
            </div>

            <AjusteTotal Datos="factura" OnCambio="Recalcular" />

            @if (formaPago?.EsMercadoPago == true)
            {
                <p class="sub">Se va a mostrar un QR para que el cliente pague. La factura se emite cuando el pago se acredita.</p>
            }

            @if (MostrarPagaCon && formaPago?.EsEfectivo == true)
            {
                <div class="campo">
                    <label for="paga-con" class="sub-claro">Paga con</label>
                    <input id="paga-con" class="input-oscuro mono" type="number" step="0.01" min="0" @bind="pagaCon" @bind:event="oninput" />
                </div>
                @if (pagaCon > 0)
                {
                    <div class="t-vuelto @(vuelto < 0 ? "falta" : "")">
                        <span>@(vuelto < 0 ? "Falta" : "Vuelto")</span>
                        <span class="mono">@Pesos(Math.Abs(vuelto))</span>
                    </div>
                }
            }

            @if (MotivoNoEmitir != null)
            {
                <p class="alerta alerta-aviso">@MotivoNoEmitir</p>
            }

            @if (resultado != null && !resultado.Ok)
            {
                <div class="alerta alerta-error" role="alert">
                    @resultado.Mensaje
                    @if (resultado.FacturaId != null)
                    {
                        <span> La factura quedó guardada sin CAE.</span>
                        <button type="button" class="btn btn-chico" disabled="@emitiendo" @onclick="Reintentar">Reintentar CAE</button>
                    }
                </div>
            }

            <div class="t-spacer"></div>
            @if (emitiendo)
            {
                <button type="button" class="btn-emitir" disabled>Pidiendo CAE a ARCA…</button>
            }
            else
            {
                <button type="button" class="btn-emitir" disabled="@(!PuedeEmitir)" @onclick="@(() => Emitir("ticket"))">Factura en ticket  ·  F8</button>
                <button type="button" class="btn-emitir-sec" disabled="@(!PuedeEmitir)" @onclick="@(() => Emitir("a4"))">Factura en A4  ·  F9</button>
                @* Nota de pedido: oculta en pantalla, se usa solo con Ctrl+F9 / Ctrl+F10 / Ctrl+F11 *@
                @if (MostrarBotonesPedido)
                {
                <div class="pedido-fila">
                    <span class="sub-claro">Nota de pedido</span>
                    <div class="pedido-btns">
                        <button type="button" class="btn-pedido" disabled="@(!PuedeEmitir)" @onclick="@(() => Emitir("ticket", fiscal: false))">Ticket · Ctrl+F10</button>
                        <button type="button" class="btn-pedido" disabled="@(!PuedeEmitir)" @onclick="@(() => Emitir("a4", fiscal: false))">A4 · Ctrl+F9</button>
                        <button type="button" class="btn-pedido" disabled="@(!PuedeEmitir)" @onclick="@(() => Emitir(null, fiscal: false))">Sin imprimir · Ctrl+F11</button>
                    </div>
                </div>
                }
            }
        }
    </aside>
</div>

@* Cobro con el QR de Mercado Pago: la factura se emite cuando el pago se acredita. *@
@if (pagoQr != null || qrOcupado || qrError != null)
{
    <div class="modal-fondo">
        <section class="panel modal-qr" role="dialog" aria-modal="true" aria-label="Cobro con QR">
            <header class="modal-cab">
                <div>
                    <h2>Cobrar con QR</h2>
                    <span class="sub">@formaPago?.Nombre · @Pesos(totales.Total)</span>
                </div>
                <button type="button" class="modal-cerrar" aria-label="Cerrar" disabled="@qrOcupado" @onclick="CerrarQr">×</button>
            </header>

            @if (qrOcupado && qrImagen == null)
            {
                <p>Generando el QR…</p>
            }
            else if (qrError != null)
            {
                <p class="alerta alerta-error" role="alert">@qrError</p>
            }
            else if (qrImagen != null)
            {
                <div class="qr-caja">
                    <img class="qr-img" src="@qrImagen" alt="QR para pagar" />
                    <p class="qr-monto mono">@Pesos(totales.Total)</p>
                    <p class="sub">@(pagoQr?.Interoperable == false
                        ? "Este QR sólo lo lee la app de Mercado Pago."
                        : "El cliente lo escanea con Mercado Pago, MODO o la app de su banco.")</p>
                    @if (pagoQr?.Estado == EstadoPagoQr.Creada)
                    {
                        <p class="qr-estado">Esperando el pago…</p>
                    }
                    @if (pagoQr != null)
                    {
                        <p class="sub mono qr-tecnico">@pagoQr.OrderId @pagoQr.Detalle</p>
                    }
                </div>
            }

            <div class="fila-btns">
                <button type="button" class="btn" disabled="@qrOcupado" @onclick="VerificarQr">Ya pagó, verificar</button>
                <div class="crece"></div>
                <button type="button" class="btn btn-rojo" disabled="@qrOcupado" @onclick="CerrarQr">Cancelar el cobro</button>
            </div>
        </section>
    </div>
}
}

@code {
    private static readonly CultureInfo Ar = new("es-AR");

    private bool cargando = true;
    private string errorCarga;
    private SesionActual sesion;
    private EmpresaDatos empresa;
    private FacturacionService.ParametrosIva param;
    private List<FormaPagoItem> formasPago = new();
    private CajaTurno turno;

    private NuevaFactura factura = new();
    private FormaPagoItem formaPago;
    private TotalesFactura totales = new();
    private RenglonCarrito ultimoAgregado;

    private string textoBusqueda;
    private string ultimaBusqueda;
    private decimal cantidadBusqueda = 1;
    private List<ProductoItem> resultados = new();
    private bool sinResultados;

    private bool verCliente;
    private decimal pagaCon;
    private bool emitiendo;
    private ResultadoEmision resultado;
    private DotNetObjectReference<Facturar> refJs;

    private string telefonoWhatsApp;

    /// <summary>Link de WhatsApp con el mensaje listo y el link público al comprobante recién emitido.</summary>
    private string LinkWhatsApp
    {
        get
        {
            if (resultado?.FacturaId == null) return "#";
            var sitio = string.IsNullOrWhiteSpace(Tenants.UrlPublica) ? Nav.BaseUri : Tenants.UrlPublica.TrimEnd('/') + "/";
            var link = sitio + APC.Core.Seguridad.EnlaceComprobante.Ruta(Tenants.CarpetaDatos, sesion.Tenant.Codigo, resultado.FacturaId.Value, false);
            var comercio = string.IsNullOrWhiteSpace(sesion.Tenant.NombreFantasia) ? empresa.Nombre : sesion.Tenant.NombreFantasia;
            var comprobante = resultado.EsNotaPedido
                ? $"nota de pedido Nº {resultado.Numero:00000000}"
                : $"Factura {resultado.Letra} {resultado.PuntoVenta:00000}-{resultado.Numero:00000000}";
            return APC.Core.Seguridad.EnlaceComprobante.WhatsApp(telefonoWhatsApp,
                $"Hola! Te enviamos tu {comprobante} de {comercio}. Podés verla y descargarla acá: {link}");
        }
    }

    /// <summary>/?presupuesto={id}: carga un presupuesto guardado para facturarlo.</summary>
    [SupplyParameterFromQuery(Name = "presupuesto")] public Guid? PresupuestoId { get; set; }
    private Guid? presupuestoOrigenId;
    private string presupuestoOrigen;

    private string Letra => empresa.EsMonotributo ? "C" : factura.Condicion == CondicionReceptor.ResponsableInscripto ? "A" : "B";
    private decimal vuelto => pagaCon - totales.Total;
    /// <summary>"Paga con" y vuelto ocultos por ahora; poner en true para volver a mostrarlos.</summary>
    private const bool MostrarPagaCon = false;

    // ---- cobro con QR de Mercado Pago ----
    private PagoQr pagoQr;
    private string qrImagen;
    private string qrError;
    private bool qrOcupado;
    private string qrFormato;
    private bool qrFiscal = true;
    private CancellationTokenSource qrCts;
    /// <summary>Botones de nota de pedido ocultos: funcionan solo con las teclas.</summary>
    private const bool MostrarBotonesPedido = false;
    /// <summary>Sucursales donde el dueño factura solo: no se les pide abrir la caja (script 16).</summary>
    private bool ExigeCaja => sesion?.Sucursal?.ExigeCaja ?? true;

    private string EstadoCaja =>
        turno != null ? "Caja abierta " + turno.FechaApertura.ToString("HH:mm")
        : ExigeCaja ? "Caja cerrada" : "Sin caja";

    private bool PuedeEmitir => !emitiendo && (turno != null || !ExigeCaja) && factura.Renglones.Count > 0 && formaPago != null && !FaltanPrecios
                                && (formaPago.EsEfectivo == false || pagaCon == 0 || pagaCon >= totales.Total);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sesion = await SesionSrv.ObtenerAsync();
            // Lo que ve cada rol lo configura CM Tech en Empresas → Módulos.
            if (!sesion.TieneModulo(Modulo.Facturar)) { Nav.NavigateTo("/sin-permiso"); return; }
            empresa = await Catalogo.EmpresaAsync(sesion.Cs);
            if (empresa == null) { errorCarga = "Falta cargar los datos de la empresa."; return; }
            param = await Facturacion.ParametrosAsync(sesion.Cs);
            formasPago = (await Catalogo.FormasPagoAsync(sesion.Cs)).Where(f => !f.EsCtaCte).ToList();
            AplicarFormaPago(formasPago.FirstOrDefault(f => f.EsEfectivo) ?? formasPago.FirstOrDefault());
            turno = await Caja.TurnoAbiertoAsync(sesion.Cs, sesion.UsuarioId);
            if (PresupuestoId != null) await CargarPresupuesto(PresupuestoId.Value);
        }
        catch (Exception ex)
        {
            errorCarga = "No se pudo conectar con la base de datos: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!cargando && refJs == null && errorCarga == null)
        {
            refJs = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("apc.registrarAtajos", refJs);
            await JS.InvokeVoidAsync("apc.enfocar", "buscar");
        }
    }

    // Mismas teclas que APC.WinForms (Ctrl+F5 pasa a Ctrl+F9: en el navegador Ctrl+F5 recarga la página)
    [JSInvokable] public Task AtajoFacturaTicket() => AtajoEmitirFormato("ticket");                    // F8
    [JSInvokable] public Task AtajoFacturaA4() => AtajoEmitirFormato("a4");                            // F9
    [JSInvokable] public Task AtajoPedidoA4() => AtajoEmitirFormato("a4", fiscal: false);              // Ctrl+F9
    [JSInvokable] public Task AtajoPedidoTicket() => AtajoEmitirFormato("ticket", fiscal: false);      // Ctrl+F10
    [JSInvokable] public Task AtajoPedidoSinImprimir() => AtajoEmitirFormato(null, fiscal: false);     // Ctrl+F11
    [JSInvokable] public void AtajoPresupuesto() { }   // Ctrl+F12: los presupuestos se hacen en su propia pantalla

    private async Task AtajoEmitirFormato(string formato, bool fiscal = true)
    {
        if (pagoQr != null || qrOcupado) return;
        if (resultado?.Ok == true) Nueva();
        else if (PuedeEmitir) await Emitir(formato, fiscal);
        StateHasChanged();
    }
    [JSInvokable] public void AtajoCliente() { ToggleCliente(); StateHasChanged(); }
    [JSInvokable] public void AtajoNueva() { if (resultado?.Ok == true) { Nueva(); StateHasChanged(); } }

    private async Task BuscarKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { resultados.Clear(); sinResultados = false; return; }
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(textoBusqueda)) return;

        var texto = textoBusqueda.Trim();
        cantidadBusqueda = 1;
        var asterisco = texto.IndexOf('*');
        if (asterisco > 0 && decimal.TryParse(texto[..asterisco].Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var cant) && cant > 0)
        {
            cantidadBusqueda = cant;
            texto = texto[(asterisco + 1)..].Trim();
        }

        ultimaBusqueda = texto;
        resultados = await Catalogo.BuscarProductosAsync(sesion.Cs, texto);
        sinResultados = resultados.Count == 0;
        if (resultados.Count == 1) await Agregar(resultados[0], cantidadBusqueda);
    }

    private async Task Agregar(ProductoItem p, decimal cantidad)
    {
        var existente = p.PrecioVenta1 <= 0 ? null : factura.Renglones.FirstOrDefault(r => r.Producto.Id == p.Id);
        if (existente != null) existente.Cantidad += cantidad;
        else
        {
            existente = new RenglonCarrito { Producto = p, Cantidad = cantidad, PrecioUnitario = p.PrecioVenta1 };
            factura.Renglones.Add(existente);
        }
        ultimoAgregado = existente;
        textoBusqueda = "";
        resultados.Clear();
        sinResultados = false;
        cantidadBusqueda = 1;
        Recalcular();
        if (existente.PrecioLibre)
        {
            StateHasChanged();
            await Task.Yield();
            await JS.InvokeVoidAsync("apc.enfocar", "pu-" + existente.Clave);
        }
        else
        {
            await JS.InvokeVoidAsync("apc.enfocar", "buscar");
        }
    }

    private void SetPrecio(RenglonCarrito r, string valor)
    {
        if (decimal.TryParse(valor, NumberStyles.Number, CultureInfo.InvariantCulture, out var pu) && pu >= 0)
            r.PrecioUnitario = Math.Round(pu, 2);
        Recalcular();
    }

    private async Task PrecioKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await JS.InvokeVoidAsync("apc.enfocar", "buscar");
    }

    private readonly HashSet<string> editandoPrecio = new();

    private async Task EditarPrecio(RenglonCarrito r)
    {
        editandoPrecio.Add(r.Clave);
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("apc.enfocar", "pu-" + r.Clave);
    }

    /// <summary>Por qué el botón de emitir está deshabilitado (null si se puede emitir o no hay nada cargado).</summary>
    private string MotivoNoEmitir =>
        emitiendo || factura.Renglones.Count == 0 ? null :
        turno == null && ExigeCaja ? "La caja está cerrada: abrila en Arqueo para poder facturar." :
        formasPago.Count == 0 ? "No hay formas de pago cargadas en esta empresa. Pedile a CM Tech que las configure." :
        formaPago == null ? "Elegí la forma de pago." :
        FaltanPrecios ? "Hay renglones sin precio. Escribilo en el renglón marcado." :
        formaPago.EsEfectivo && pagaCon > 0 && pagaCon < totales.Total ? "El monto con el que paga no alcanza." :
        null;

    private bool FaltanPrecios => factura.Renglones.Any(r => r.PrecioUnitario <= 0);

    private void CambiarCantidad(RenglonCarrito r, decimal delta)
    {
        r.Cantidad = Math.Max(0, r.Cantidad + delta);
        if (r.Cantidad == 0) factura.Renglones.Remove(r);
        Recalcular();
    }

    private void SetCantidad(RenglonCarrito r, string valor)
    {
        if (decimal.TryParse(valor, NumberStyles.Number, CultureInfo.InvariantCulture, out var c) && c >= 0)
        {
            r.Cantidad = c;
            if (c == 0) factura.Renglones.Remove(r);
        }
        Recalcular();
    }

    private void Quitar(RenglonCarrito r) { factura.Renglones.Remove(r); Recalcular(); }

    private void ElegirPago(FormaPagoItem fp) { AplicarFormaPago(fp); if (!fp.EsEfectivo) pagaCon = 0; Recalcular(); }

    /// <summary>Como SetRecargo de APC: la forma de pago propone el descuento o recargo sobre el total (se puede cambiar a mano).</summary>
    private void AplicarFormaPago(FormaPagoItem fp)
    {
        formaPago = fp;
        factura.DescuentoTotalPorc = fp?.PorcentajeDescuento ?? 0;
        factura.RecargoTotalPorc = fp?.PorcentajeRecargo ?? 0;
    }

    private void ToggleCliente() => verCliente = !verCliente;

    private void Recalcular() =>
        totales = FacturacionService.CalcularTotales(factura, param.General, param.Diferenciada, empresa.EsMonotributo);

    /// <param name="formato">"ticket" (80 mm), "a4", o null para guardar sin imprimir.</param>
    /// <param name="fiscal">false = nota de pedido (no fiscal, sin CAE).</param>
    private async Task Emitir(string formato, bool fiscal = true)
    {
        if (!PuedeEmitir) return;
        // Con QR primero se cobra: la factura se emite recién cuando Mercado Pago acredita el pago.
        if (formaPago?.EsMercadoPago == true && pagoQr?.Pagado != true)
        {
            await IniciarCobroQr(formato, fiscal);
            return;
        }
        await EmitirAhora(formato, fiscal);
    }

    private async Task EmitirAhora(string formato, bool fiscal)
    {
        emitiendo = true;
        resultado = null;
        StateHasChanged();
        try
        {
            factura.FormaPagoId = formaPago.Id;
            resultado = await Facturacion.EmitirAsync(sesion.Tenant, sesion.UsuarioId, factura, fiscal, sesion.Sucursal);
            if (resultado.FacturaId != null && presupuestoOrigenId != null)
            {
                await Presupuestos.MarcarFacturadoAsync(sesion.Cs, presupuestoOrigenId.Value);
                presupuestoOrigenId = null;
                presupuestoOrigen = null;
            }
            if (resultado.Ok && resultado.FacturaId != null && formato != null)
                await JS.InvokeVoidAsync("apc.imprimir", $"/imprimir/{resultado.FacturaId}?formato={formato}");
        }
        catch (Exception ex)
        {
            resultado = new ResultadoEmision { Ok = false, Mensaje = "Error inesperado: " + ex.Message };
        }
        finally
        {
            emitiendo = false;
        }
    }

    // ------------------------------------------------------------------ cobro con QR

    private async Task IniciarCobroQr(string formato, bool fiscal)
    {
        qrFormato = formato;
        qrFiscal = fiscal;
        qrError = null;
        qrImagen = null;
        pagoQr = null;
        qrOcupado = true;
        StateHasChanged();
        try
        {
            var (orden, pago) = await MpSrv.CobrarAsync(
                sesion.Tenant, sesion.Sucursal, sesion.UsuarioId, totales.Total, DescripcionCobro());
            pagoQr = pago;
            if (!orden.Ok) { qrError = orden.Mensaje; return; }
            qrImagen = FacturacionService.QrDataUri(orden.QrData);
            EsperarPago();
        }
        catch (Exception ex)
        {
            qrError = "No se pudo generar el QR: " + ex.Message;
        }
        finally
        {
            qrOcupado = false;
        }
    }

    private string DescripcionCobro()
    {
        var primero = factura.Renglones.FirstOrDefault()?.Producto?.Nombre ?? "Venta";
        return factura.Renglones.Count > 1 ? $"{primero} y {factura.Renglones.Count - 1} más" : primero;
    }

    /// <summary>Le pregunta a Mercado Pago cada 3 segundos hasta que el pago se acredita o se vence.</summary>
    private void EsperarPago()
    {
        DetenerEspera();
        qrCts = new CancellationTokenSource();
        var ct = qrCts.Token;
        var id = pagoQr.Id;
        _ = Task.Run(async () =>
        {
            try
            {
                while (!ct.IsCancellationRequested)
                {
                    await Task.Delay(3000, ct);
                    var p = await MpSrv.RefrescarAsync(sesion.Tenant, id);
                    if (ct.IsCancellationRequested) return;
                    var listo = p != null && p.Estado != EstadoPagoQr.Creada;
                    await InvokeAsync(async () =>
                    {
                        if (pagoQr?.Id != id) return;
                        pagoQr = p;
                        if (!listo) { StateHasChanged(); return; }
                        if (p.Pagado) await EmitirConQr();
                        else { qrError = MensajeEstado(p); StateHasChanged(); }
                    });
                    if (listo) return;
                }
            }
            catch (OperationCanceledException) { }
            catch (Exception ex)
            {
                try { await InvokeAsync(() => { qrError = ex.Message; StateHasChanged(); }); } catch { }
            }
        });
    }

    private void DetenerEspera()
    {
        try { qrCts?.Cancel(); } catch { }
        qrCts?.Dispose();
        qrCts = null;
    }

    private static string MensajeEstado(PagoQr p) => p.Estado switch
    {
        EstadoPagoQr.Vencida => "El QR se venció. Volvé a generarlo.",
        EstadoPagoQr.Cancelada => "El cobro se canceló.",
        _ => "Mercado Pago rechazó el pago. " + (p.Detalle ?? "")
    };

    private async Task VerificarQr()
    {
        if (pagoQr == null) return;
        qrOcupado = true;
        StateHasChanged();
        try
        {
            var p = await MpSrv.RefrescarAsync(sesion.Tenant, pagoQr.Id);
            if (p == null) return;
            pagoQr = p;
            if (p.Pagado) { qrOcupado = false; await EmitirConQr(); return; }
            if (p.Estado != EstadoPagoQr.Creada) qrError = MensajeEstado(p);
            else qrError = null;
        }
        catch (Exception ex) { qrError = ex.Message; }
        finally { qrOcupado = false; }
    }

    /// <summary>El pago se acreditó: se cierra el QR, se emite la factura y se la asocia al cobro.</summary>
    private async Task EmitirConQr()
    {
        var formato = qrFormato;
        var fiscal = qrFiscal;
        var pagoId = pagoQr?.Id;
        DetenerEspera();
        pagoQr = null;
        qrImagen = null;
        qrError = null;
        await EmitirAhora(formato, fiscal);
        if (pagoId != null && resultado?.FacturaId != null)
        {
            try { await MpSrv.AsociarFacturaAsync(sesion.Cs, pagoId.Value, resultado.FacturaId.Value); } catch { }
        }
        StateHasChanged();
    }

    private async Task CerrarQr()
    {
        var id = pagoQr?.Id;
        var pendiente = pagoQr != null && pagoQr.Estado == EstadoPagoQr.Creada;
        DetenerEspera();
        pagoQr = null;
        qrImagen = null;
        qrError = null;
        qrOcupado = false;
        if (pendiente && id != null)
        {
            try { await MpSrv.CancelarAsync(sesion.Tenant, id.Value); } catch { }
        }
    }

    private async Task Reimprimir(string formato) =>
        await JS.InvokeVoidAsync("apc.imprimir", $"/imprimir/{resultado.FacturaId}?formato={formato}");

    private async Task CargarPresupuesto(Guid id)
    {
        var f = await Presupuestos.ACarritoAsync(sesion.Cs, id);
        if (f == null) return;
        factura = f;
        editandoPrecio.Clear();
        pagaCon = 0;
        verCliente = !string.IsNullOrWhiteSpace(f.ClienteDocumento);
        formaPago = formasPago.FirstOrDefault(x => x.Id == f.FormaPagoId) ?? formasPago.FirstOrDefault(x => x.EsEfectivo) ?? formasPago.FirstOrDefault();
        presupuestoOrigenId = id;
        presupuestoOrigen = f.Observaciones?.Replace("Presupuesto Nº ", "");
        Recalcular();
    }

    private async Task Reintentar()
    {
        if (resultado?.FacturaId == null) return;
        emitiendo = true;
        StateHasChanged();
        try { resultado = await Facturacion.SolicitarCaeAsync(sesion.Tenant, resultado.FacturaId.Value); }
        finally { emitiendo = false; }
    }

    private void Nueva()
    {
        presupuestoOrigenId = null;
        presupuestoOrigen = null;
        factura = new NuevaFactura();
        telefonoWhatsApp = null;
        editandoPrecio.Clear();
        resultado = null;
        pagaCon = 0;
        verCliente = false;
        ultimoAgregado = null;
        DetenerEspera();
        pagoQr = null;
        qrImagen = null;
        qrError = null;
        AplicarFormaPago(formasPago.FirstOrDefault(f => f.EsEfectivo) ?? formasPago.FirstOrDefault());
        Recalcular();
        _ = JS.InvokeVoidAsync("apc.enfocar", "buscar");
    }

    private string EtiquetaIva(ProductoItem p) =>
        empresa.EsMonotributo ? "" :
        p.IvaExento ? "No gravado" :
        p.IvaDiferenciado ? $"IVA {param.Diferenciada.ToString("0.##", Ar)}%" : $"IVA {param.General.ToString("0.##", Ar)}%";

    private static string Pesos(decimal v) => "$ " + v.ToString("N2", Ar);

    public async ValueTask DisposeAsync()
    {
        DetenerEspera();
        try { await JS.InvokeVoidAsync("apc.quitarAtajos"); } catch { }
        refJs?.Dispose();
    }
}
