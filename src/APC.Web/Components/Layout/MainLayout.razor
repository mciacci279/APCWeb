@using APC.Core.Tenants
@inherits LayoutComponentBase
@inject SesionService SesionSrv
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@inject IJSRuntime JS
@inject PuestoCajaService Puestos
@inject ProductoService ProductosSrv
@inject EmpresaCentralService EmpresaSrv
@implements IDisposable

<div class="app @(plegada ? "rail-plegada" : "")">
    <nav class="rail" aria-label="Menú principal">
        <div class="rail-marca">
            <button type="button" class="rail-plegar" @onclick="Plegar"
                    title="@(plegada ? "Desplegar el menú" : "Plegar el menú")"
                    aria-label="@(plegada ? "Desplegar el menú" : "Plegar el menú")" aria-expanded="@(!plegada)">
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
            </button>
            <a class="rail-logo-f360" href="/" aria-label="Factu360, ir al inicio">
                @* Logo de Factu360 (el mismo de factu360.com.ar): el círculo y la F se dibujan, aparece el 360 y la órbita gira *@
                <LogoFactu360 Tamanio="44" Prefijo="menu" />
                <span class="rail-marca-txt"><span>Factu<span class="rail-marca-dos">360</span></span><span class="rail-marca-by">by CM Tech</span></span>
            </a>
        </div>

        @* El menú va en su propio bloque: si no entra se desplaza, pero la barra nunca muestra scroll. *@
        <div class="rail-nav-caja">
        <div class="rail-nav">
        <AuthorizeView Roles="@SesionService.RolEmpleado">
            @if (Hay(Modulo.Facturar) || Hay(Modulo.Caja) || Hay(Modulo.Presupuestos))
            {
                <p class="rail-grupo">Trabajo diario</p>
            }
            @if (Hay(Modulo.Facturar))
            {
                <NavLink class="rail-btn" href="/" Match="NavLinkMatch.All" title="Facturar" aria-label="Facturar">
                    <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"></path><path d="M9 8h6M9 12h6"></path></svg></span>
                    <span>Facturar</span>
                </NavLink>
            }
            @if (Hay(Modulo.Caja))
            {
                <NavLink class="rail-btn" href="/arqueo" title="Arqueo de caja" aria-label="Arqueo de caja">
                    <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2"></rect><path d="M3 10h18M7 15h3"></path></svg></span>
                    <span>Arqueo</span>
                </NavLink>
            }
            @if (Hay(Modulo.Caja) && (sesion?.EsSupervisor == true || sesion?.EsAdmin == true))
            {
                <NavLink class="rail-btn" href="/cajas" title="Cajas: quién está en cada una" aria-label="Cajas">
                    <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h16v10H4z M7 10V6h10v4 M9 3h6v3H9z M8 14h2 M14 14h2 M8 17h8"></path></svg></span>
                    <span>Cajas</span>
                </NavLink>
            }
            @if (Hay(Modulo.Presupuestos))
            {
                <NavLink class="rail-btn rail-presu" href="/presupuestos" title="Presupuestos" aria-label="Presupuestos">
                    <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6v18h12V7z"></path><path d="M14 3v4h4"></path><path d="M9 13h6M9 17h4"></path></svg></span>
                    <span>Presup.</span>
                </NavLink>
            }
        </AuthorizeView>

        @* Qué ve cada rol de este grupo lo deciden los módulos (Empresas → Módulos). *@
        <AuthorizeView Roles="@SesionService.RolEmpleado">
            @if (HayAdministracion)
            {
                <p class="rail-grupo">Administración</p>
            }
            @if (Hay(Modulo.Productos))
            {
                <NavLink class="rail-btn" href="/productos" title="Productos" aria-label="Productos">
                    <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7l9-4 9 4-9 4-9-4z"></path><path d="M3 7v10l9 4 9-4V7"></path><path d="M12 11v10"></path></svg></span>
                    <span>Productos</span>
                    @if (bajoStockMenu > 0)
                    {
                        <span class="rail-badge" title="@bajoStockMenu productos con bajo stock">@(bajoStockMenu > 99 ? "99+" : bajoStockMenu.ToString())</span>
                    }
                </NavLink>
            }
            @if (Hay(Modulo.Clientes))
            {
                <NavLink class="rail-btn" href="/clientes" title="Clientes" aria-label="Clientes">
                    <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"></circle><path d="M5 20c0-3.9 3.1-7 7-7s7 3.1 7 7"></path></svg></span>
                    <span>Clientes</span>
                </NavLink>
            }
            @if (Hay(Modulo.Sucursales))
            {
                <NavLink class="rail-btn" href="/sucursales" title="Sucursales" aria-label="Sucursales">
                    <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"></path><path d="M4 21V9l8-5 8 5v12"></path><path d="M9 21v-5h6v5"></path></svg></span>
                    <span>Sucursales</span>
                </NavLink>
            }
            @if (Hay(Modulo.Comprobantes))
            {
                <NavLink class="rail-btn" href="/comprobantes" title="Comprobantes" aria-label="Comprobantes">
                    <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h10"></path></svg></span>
                    <span>Comprob.</span>
                </NavLink>
            }
            @if (Hay(Modulo.Reportes))
            {
                <NavLink class="rail-btn" href="/reportes" title="Reportes" aria-label="Reportes">
                    <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path></svg></span>
                    <span>Reportes</span>
                </NavLink>
            }
            @if (Hay(Modulo.Precios))
            {
                <NavLink class="rail-btn" href="/precios" title="Tipos de precio" aria-label="Tipos de precio">
                    <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12l-8 8-8-8 8-8h8z"></path><circle cx="15.5" cy="8.5" r="1.3"></circle></svg></span>
                    <span>Precios</span>
                </NavLink>
            }
            @if (Hay(Modulo.Usuarios))
            {
                <NavLink class="rail-btn" href="/usuarios" title="Usuarios" aria-label="Usuarios">
                    <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"></circle><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"></path></svg></span>
                    <span>Usuarios</span>
                </NavLink>
            }
        </AuthorizeView>

        <AuthorizeView Roles="@SesionService.RolSuperAdmin">
            <p class="rail-grupo">CM Tech</p>
            <NavLink class="rail-btn" href="/admin/empresas" title="Empresas" aria-label="Empresas">
                <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"></path><path d="M5 21V7l7-4 7 4v14"></path><path d="M9 21v-6h6v6"></path></svg></span>
                <span>Empresas</span>
            </NavLink>
            <NavLink class="rail-btn" href="/admin/tablero" title="Tablero" aria-label="Tablero">
                <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="10" rx="1.5"></rect><rect x="13" y="3" width="8" height="6" rx="1.5"></rect><rect x="13" y="11" width="8" height="10" rx="1.5"></rect><rect x="3" y="15" width="8" height="6" rx="1.5"></rect></svg></span>
                <span>Tablero</span>
            </NavLink>
            <NavLink class="rail-btn" href="/admin/trabajo" title="Trabajo" aria-label="Trabajo">
                <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="5" height="16" rx="1.5"></rect><rect x="10" y="4" width="5" height="11" rx="1.5"></rect><rect x="17" y="4" width="4" height="7" rx="1.5"></rect></svg></span>
                <span>Trabajo</span>
            </NavLink>
            <NavLink class="rail-btn" href="/admin/cobranzas" title="Cobranzas" aria-label="Cobranzas">
                <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"></rect><circle cx="12" cy="12" r="2.5"></circle><path d="M6 12h.01M18 12h.01"></path></svg></span>
                <span>Cobranzas</span>
            </NavLink>
            <NavLink class="rail-btn" href="/admin/base-datos" title="Base de datos" aria-label="Base de datos">
                <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"></path></svg></span>
                <span>Base datos</span>
            </NavLink>
            <NavLink class="rail-btn" href="/admin/configuracion" title="Configuración" aria-label="Configuración">
                <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1A1.7 1.7 0 0 0 8.9 19a1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 5 8.9a1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9.5A1.7 1.7 0 0 0 11 3V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9v.1a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"></path></svg></span>
                <span>Config.</span>
            </NavLink>
        </AuthorizeView>

        </div>
        @* Aviso de que el menú sigue más abajo: lo muestra app.js sólo cuando no entra en la pantalla *@
        <button type="button" class="rail-mas" aria-label="Ver más opciones del menú" title="Hay más opciones abajo">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
        </button>
        </div>

        @if (sesion != null)
        {
            <div class="rail-quien" title="@Quien">
                <span class="rail-quien-fila">
                    <span class="rail-avatar" aria-hidden="true">@Iniciales</span>
                    <span class="rail-quien-nombre">@NombreMostrado</span>
                </span>
                <span class="rail-quien-dato">@(sesion.EsSuperAdmin ? "CM Tech" : Comercio)</span>
                @if (!sesion.EsSuperAdmin && sesion.Sucursal != null)
                {
                    <span class="rail-quien-dato rail-quien-suc">@sesion.Sucursal.Nombre</span>
                    <span class="rail-quien-dato">Pto. Vta. @sesion.PuntoVenta.ToString("0000")</span>
                }
                @if (sesion.Caja != null)
                {
                    <button type="button" class="rail-caja" @onclick="CambiarCaja" title="Cambiar de caja">
                        <span class="rail-caja-punto" aria-hidden="true"></span>
                        <span>@sesion.Caja.TituloCaja</span>
                        <span class="rail-caja-cambiar">cambiar</span>
                    </button>
                }
            </div>
        }
        <form method="post" action="/cuenta/salir" data-enhance="false">
            <AntiforgeryToken />
            <button type="submit" class="rail-btn" title="Salir" aria-label="Salir">
                <span class="rail-ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4h4v16h-4"></path><path d="M10 8l-4 4 4 4M6 12h10"></path></svg></span>
                <span>Salir</span>
            </button>
        </form>
    </nav>
    <div class="app-main">
        @if (avisoAbono != null)
        {
            <p class="aviso-abono" role="status">@avisoAbono</p>
        }
        @if (pideCaja)
        {
            @* La sucursal tiene varias cajas: hasta que elija una, no se muestra la pantalla *@
            <SelectorCaja Cs="@sesion.Cs" UsuarioId="sesion.UsuarioId" SucursalId="sesion.SucursalId"
                          Nombre="@NombreMostrado" Sucursal="@sesion.Sucursal?.Nombre" Aviso="@avisoCaja"
                          PuedeSeguirSinCaja="sesion.EsAdmin" PuedeVolver="sesion.Caja != null"
                          OnElegida="CajaElegida" OnSinCaja="EntrarSinCaja" OnCancelar="() => pideCaja = false"
                          LogoEmpresa="@logoEmpresa" Empresa="@NombreEmpresa" />
        }
        else if (!listo)
        {
            @* Hasta saber en qué caja está el usuario, la página no arranca: abriría el turno equivocado *@
            <div class="page-pad" aria-busy="true"><table class="tabla"><tbody><FilasEsqueleto /></tbody></table></div>
        }
        else
        {
            @Body
        }
    </div>
</div>

<div id="blazor-error-ui" class="error-ui">
    Se perdió la conexión con el servidor.
    <a href="" class="reload">Recargar</a>
</div>

@code {
    private string avisoAbono;
    private SesionActual sesion;

    /// <summary>Nombre de fantasía del comercio; si no tiene, la razón social.</summary>
    private string Comercio => sesion?.Tenant == null ? "" :
        string.IsNullOrWhiteSpace(sesion.Tenant.NombreFantasia) ? sesion.Tenant.Nombre : sesion.Tenant.NombreFantasia;

    private bool plegada;
    private bool leido;

    private string NombreMostrado => string.IsNullOrWhiteSpace(sesion?.Nombre) ? sesion?.Usuario : sesion.Nombre;

    /// <summary>Iniciales para el círculo del pie: "Miguel Ciacci" → "MC".</summary>
    private string Iniciales
    {
        get
        {
            var partes = (NombreMostrado ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (partes.Length == 0) return "?";
            var letras = partes.Length == 1 ? partes[0][..1] : partes[0][..1] + partes[1][..1];
            return letras.ToUpperInvariant();
        }
    }

    /// <summary>Módulo habilitado para la empresa (lo configura CM Tech en Empresas → Módulos).</summary>
    private bool Hay(string modulo) => sesion == null || sesion.TieneModulo(modulo);

    private bool HayAdministracion =>
        Hay(Modulo.Productos) || Hay(Modulo.Clientes) || Hay(Modulo.Sucursales)
        || Hay(Modulo.Comprobantes) || Hay(Modulo.Reportes) || Hay(Modulo.Precios) || Hay(Modulo.Usuarios);

    private async Task Plegar()
    {
        plegada = !plegada;
        try { await JS.InvokeVoidAsync("apc.guardar", "menu-plegado", plegada ? "1" : "0"); } catch { }
    }

    private string Quien => sesion == null ? "" :
        $"{sesion.Nombre} · {(sesion.EsSuperAdmin ? "CM Tech" : Comercio)}" +
        (sesion.Sucursal == null ? "" : " · " + sesion.Sucursal.Nombre);

    /// <summary>Ya se sabe en qué caja está el usuario (o que no hay cajas): recién ahí se muestra la página.</summary>
    private bool listo;

    protected override async Task OnInitializedAsync()
    {
        try { await IniciarAsync(); }
        finally { listo = true; }
    }

    private async Task IniciarAsync()
    {
        // Si la empresa fue suspendida con el usuario adentro, se cierra la sesión
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (user?.Identity?.IsAuthenticated != true) return;
        sesion = await SesionSrv.ObtenerAsync();
        if (sesion == null) { Nav.NavigateTo("/cuenta/expirada", forceLoad: true); return; }

        // Abono vencido, dentro de los días de gracia: aviso para el administrador del comercio.
        var t = sesion.Tenant;
        await RevisarCajaAsync();
        await MirarBajoStockAsync();

        if (t != null && sesion.EsAdmin && t.AbonoVencido && !t.SuspendidaPorAbono)
            avisoAbono = $"El abono del sistema venció el {t.AbonoPagoHasta:dd/MM/yyyy}. " +
                         (t.AbonoDiasParaSuspension <= 1 ? "El servicio se suspende mañana." : $"El servicio se suspende en {t.AbonoDiasParaSuspension} días.") +
                         " Comunicate con CM Tech para regularizarlo.";
    }

    /// <summary>
    /// Si la empresa no tiene el módulo, la página no se abre ni escribiendo la dirección.
    /// Se mira acá, en el layout, para no repetir el control en cada página.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (sesion == null || sesion.EsSuperAdmin) return;
        var ruta = new Uri(Nav.Uri).AbsolutePath;
        var modulo = Modulo.DeRuta(ruta);
        if (modulo != null && !sesion.TieneModulo(modulo)) Nav.NavigateTo("/sin-permiso");
    }

    // ------------------------------------------------------------------ marca de la empresa (selector de caja)

    private string logoEmpresa;
    private bool logoBuscado;
    private string NombreEmpresa => sesion?.Tenant == null ? null
        : string.IsNullOrWhiteSpace(sesion.Tenant.NombreFantasia) ? sesion.Tenant.Nombre : sesion.Tenant.NombreFantasia;

    /// <summary>Logo de la empresa para la pantalla de elegir caja (se busca una vez).</summary>
    private async Task BuscarLogoAsync()
    {
        if (logoBuscado || sesion?.Tenant == null) return;
        logoBuscado = true;
        try { logoEmpresa = await EmpresaSrv.LogoDataUriAsync(sesion.Tenant.Id); } catch (Exception) { logoEmpresa = null; }
    }

    // ------------------------------------------------------------------ alerta de bajo stock (menú)

    /// <summary>Productos con bajo stock en la sucursal del usuario: número en el botón Productos del menú.</summary>
    private int bajoStockMenu;
    private DateTime bajoStockMirado;

    protected override async Task OnParametersSetAsync() => await MirarBajoStockAsync();

    /// <summary>Se vuelve a contar al navegar, como mucho una vez por minuto.</summary>
    private async Task MirarBajoStockAsync()
    {
        if (sesion == null || sesion.EsSuperAdmin || string.IsNullOrEmpty(sesion.Cs) || !sesion.TieneModulo(Modulo.Productos)) return;
        if ((DateTime.Now - bajoStockMirado).TotalSeconds < 60) return;
        bajoStockMirado = DateTime.Now;
        try { bajoStockMenu = await ProductosSrv.ContarBajoStockAsync(sesion.Cs, sesion.SucursalId == Guid.Empty ? null : sesion.SucursalId); }
        catch (Exception) { bajoStockMenu = 0; }
    }

    // ------------------------------------------------------------------ caja del usuario

    private bool pideCaja;
    private string avisoCaja;
    private Timer latido;

    /// <summary>
    /// Si la sucursal tiene más de una caja, el usuario tiene que elegir en cuál trabaja.
    /// Si ya estaba en una (recargó la página u otra pestaña), sigue en esa.
    /// </summary>
    private async Task RevisarCajaAsync()
    {
        if (sesion == null || sesion.EsSuperAdmin || sesion.Sucursal == null || string.IsNullOrEmpty(sesion.Cs)) return;
        await BuscarLogoAsync();
        try
        {
            if (!await Puestos.ExisteAsync(sesion.Cs)) return;   // sin el script 27 todo sigue como antes
            if (sesion.Caja == null)
            {
                var activa = await Puestos.ActivaDeUsuarioAsync(sesion.Cs, sesion.UsuarioId);
                if (activa != null && activa.SucursalId == sesion.SucursalId) sesion.Caja = activa;
            }
            if (sesion.Caja == null && !sesion.SinCaja && await Puestos.ContarActivasAsync(sesion.Cs, sesion.SucursalId) > 1)
                pideCaja = true;
        }
        catch (Exception) { /* sin conexión a la base de la empresa: se sigue sin cajas */ }

        if (sesion.Caja != null) IniciarLatido();
    }

    private void CajaElegida(PuestoCajaSesion s)
    {
        sesion.Caja = s;
        sesion.SinCaja = false;
        pideCaja = false;
        avisoCaja = null;
        IniciarLatido();
    }

    private void EntrarSinCaja()
    {
        sesion.SinCaja = true;
        pideCaja = false;
        avisoCaja = null;
    }

    private void CambiarCaja()
    {
        avisoCaja = null;
        pideCaja = true;
    }

    /// <summary>
    /// Cada minuto avisa que el usuario sigue en la caja. Si la sesión ya no está abierta
    /// (la liberó un supervisor o venció por inactividad), vuelve a pedir la caja.
    /// </summary>
    private void IniciarLatido()
    {
        latido?.Dispose();
        latido = new Timer(async _ =>
        {
            try
            {
                var caja = sesion?.Caja;
                if (caja == null) return;
                if (await Puestos.LatirAsync(sesion.Cs, caja.Id)) return;
                await InvokeAsync(() =>
                {
                    sesion.Caja = null;
                    avisoCaja = $"{caja.TituloCaja} se liberó (la liberó un supervisor o estuvo {PuestoCajaService.MinutosInactividad} minutos sin conexión). Elegí de nuevo en cuál trabajás.";
                    pideCaja = true;
                    StateHasChanged();
                });
            }
            catch (Exception) { /* sin conexión: se reintenta en el próximo minuto */ }
        }, null, 60_000, 60_000);
    }

    public void Dispose() => latido?.Dispose();

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (!primera || leido) return;
        leido = true;
        try
        {
            var guardado = await JS.InvokeAsync<string>("apc.leer", "menu-plegado");
            if (guardado == "1") { plegada = true; StateHasChanged(); }
        }
        catch { }
    }
}
