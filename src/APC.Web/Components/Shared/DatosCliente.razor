@* Datos del cliente del comprobante: búsqueda en el fichero de clientes y traído de ARCA por CUIT. *@
@inject SesionService SesionSrv
@inject ClienteService ClienteSrv
@inject PadronService Padron

<section class="panel cliente" aria-label="Datos del cliente">
    @* 1) Buscar: en el fichero de clientes o en ARCA por CUIT *@
    <div class="cliente-busqueda">
        <div class="campo cliente-bloque">
            <label for="cli-buscar">Buscar en tus clientes</label>
            <div class="buscador-cliente">
                <input id="cli-buscar" class="input" autocomplete="off" placeholder="Nombre o documento + Enter"
                       disabled="@Deshabilitado" @bind="texto" @bind:event="oninput" @onkeydown="BuscarKey" />
                @if (resultados.Count > 0)
                {
                    <ul class="resultados" role="listbox" aria-label="Clientes encontrados">
                        @foreach (var c in resultados)
                        {
                            <li>
                                <button type="button" class="resultado" @onclick="() => Elegir(c)">
                                    <span class="r-nombre">@c.NombreCompleto</span>
                                    <span class="r-cod">@c.Documento</span>
                                    <span class="r-precio">@c.CondicionIva</span>
                                </button>
                            </li>
                        }
                    </ul>
                }
                else if (sinResultados)
                {
                    <p class="sub">No se encontró ningún cliente. Buscalo en ARCA por CUIT o cargá los datos a mano.</p>
                }
            </div>
        </div>

        <span class="cliente-o" aria-hidden="true">o</span>

        <div class="campo cliente-bloque cliente-arca">
            <label for="cli-doc">CUIT / DNI del cliente</label>
            <div class="cliente-arca-fila">
                <input id="cli-doc" class="input mono" maxlength="13" inputmode="numeric" placeholder="20123456789"
                       disabled="@Deshabilitado" @bind="Datos.ClienteDocumento" @bind:after="Aviso" @onkeydown="DocKey" />
                <button type="button" class="btn btn-arca" disabled="@(Deshabilitado || consultando)" @onclick="TraerDeArca"
                        title="Busca el CUIT en el padrón de ARCA y trae razón social, domicilio y condición frente al IVA">
                    @if (consultando) { <span class="btn-arca-giro" aria-hidden="true"></span> } else { <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg> }
                    @(consultando ? "Buscando…" : "Buscar en ARCA")
                </button>
            </div>
        </div>
    </div>

    @if (mensaje != null)
    {
        <div class="cliente-aviso">
            <p class="alerta @(mensajeOk ? "alerta-ok" : "alerta-error")" role="status">@mensaje</p>
            @if (ultimaArca != null && (ultimaArca.RespuestaA13 != null || ultimaArca.RespuestaA5 != null))
            {
                <button type="button" class="btn btn-chico" @onclick="() => verArca = true" title="Ver todo lo que respondió ARCA">Ver respuesta de ARCA…</button>
            }
        </div>
    }

    @if (verArca && ultimaArca != null)
    {
        @* Respuesta completa de ARCA, en formato legible (y el XML crudo para copiar) *@
        <div class="modal-fondo" @onclick="() => verArca = false">
            <div class="panel modal-caja modal-arca" role="dialog" aria-modal="true" aria-labelledby="arca-tit" @onclick:stopPropagation="true">
                <div class="modal-cab">
                    <div>
                        <h2 id="arca-tit">Respuesta de ARCA</h2>
                        <span class="sub">CUIT @ultimaArca.Cuit · @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <button type="button" class="modal-cerrar" aria-label="Cerrar" @onclick="() => verArca = false">×</button>
                </div>
                <div class="pestanias" role="tablist">
                    <button type="button" role="tab" aria-selected="@(!verXml ? "true" : "false")" class="pestania @(!verXml ? "activa" : "")" @onclick="() => verXml = false">Datos</button>
                    <button type="button" role="tab" aria-selected="@(verXml ? "true" : "false")" class="pestania @(verXml ? "activa" : "")" @onclick="() => verXml = true">XML</button>
                </div>
                @foreach (var (titulo, xml) in Respuestas)
                {
                    <h3 class="arca-sec">@titulo</h3>
                    @if (verXml)
                    {
                        <pre class="arca-xml">@Bonito(xml)</pre>
                    }
                    else
                    {
                        <table class="tabla tabla-chica arca-datos">
                            <tbody>
                                @foreach (var f in APC.Arca.PadronA13Client.Legible(xml))
                                {
                                    <tr class="@(f.Valor == null ? "arca-grupo" : "")">
                                        <td style="padding-left: @(8 + f.Nivel * 16)px">@f.Campo</td>
                                        <td class="mono">@f.Valor</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </div>
        </div>
    }

    @* 2) Datos de la persona *@
    <div class="cliente-datos">
        <div class="campo cliente-nombre">
            <label for="cli-nombre">Nombre / razón social</label>
            <input id="cli-nombre" class="input" maxlength="50" disabled="@Deshabilitado" @bind="Datos.ClienteNombre" @bind:after="Aviso" />
        </div>

        @if (AplicaCondicion)
        {
            <div class="campo">
                <label for="cli-iva">Condición IVA</label>
                <select id="cli-iva" class="input" disabled="@Deshabilitado" @bind="Datos.Condicion" @bind:after="Cambio">
                    <option value="@CondicionReceptor.ConsumidorFinal">Consumidor final</option>
                    <option value="@CondicionReceptor.ResponsableInscripto">Responsable inscripto</option>
                    <option value="@CondicionReceptor.Monotributo">Monotributo</option>
                    <option value="@CondicionReceptor.Exento">Exento</option>
                </select>
            </div>
        }

        <div class="campo cliente-dom">
            <label for="cli-dom">Domicilio</label>
            <input id="cli-dom" class="input" maxlength="100" disabled="@Deshabilitado" @bind="Datos.ClienteDomicilio" @bind:after="Aviso" />
        </div>

        <div class="campo">
            <label for="cli-loc">Localidad</label>
            <input id="cli-loc" class="input" maxlength="100" disabled="@Deshabilitado" @bind="Datos.ClienteLocalidad" @bind:after="Aviso" />
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public NuevaFactura Datos { get; set; }
    [Parameter] public bool Deshabilitado { get; set; }
    /// <summary>Si el comprobante distingue la condición frente al IVA (la factura sí, el presupuesto no).</summary>
    [Parameter] public bool AplicaCondicion { get; set; } = true;
    [Parameter] public EventCallback OnCambio { get; set; }

    private SesionActual sesion;
    private string texto;
    private List<ClienteItem> resultados = new();
    private bool sinResultados;
    private bool consultando;
    /// <summary>Última consulta a ARCA (para "Ver respuesta de ARCA").</summary>
    private APC.Arca.PersonaPadron ultimaArca;
    private bool verArca;
    private bool verXml;

    private IEnumerable<(string, string)> Respuestas
    {
        get
        {
            if (ultimaArca?.RespuestaA13 != null) yield return ("Padrón A13 (ws_sr_padron_a13)", ultimaArca.RespuestaA13);
            if (ultimaArca?.RespuestaA5 != null) yield return ("Constancia de inscripción (ws_sr_constancia_inscripcion)", ultimaArca.RespuestaA5);
        }
    }

    /// <summary>XML con sangría para leer; si no es XML, el texto tal cual.</summary>
    private static string Bonito(string xml)
    {
        try { return System.Xml.Linq.XDocument.Parse(xml).ToString(); }
        catch (Exception) { return xml; }
    }
    private string mensaje;
    private bool mensajeOk;

    protected override async Task OnInitializedAsync() => sesion = await SesionSrv.ObtenerAsync();

    private async Task BuscarKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { resultados.Clear(); sinResultados = false; return; }
        if (e.Key != "Enter") return;
        resultados = await ClienteSrv.BuscarAsync(sesion.Cs, texto, 10);
        sinResultados = resultados.Count == 0;
    }

    private async Task Elegir(ClienteItem c)
    {
        Datos.ClienteId = c.Id;
        Datos.ClienteNombre = c.NombreCompleto;
        Datos.ClienteDocumento = c.NroDocumento;
        Datos.ClienteDomicilio = c.Domicilio;
        Datos.ClienteLocalidad = c.Localidad;
        if (AplicaCondicion) Datos.Condicion = Condicion(c.CondicionIva);

        texto = "";
        resultados.Clear();
        sinResultados = false;
        mensaje = null;
        await OnCambio.InvokeAsync();
    }

    private async Task TraerDeArca()
    {
        consultando = true;
        mensaje = null;
        StateHasChanged();
        try
        {
            var p = await Padron.ConsultarAsync(sesion.Tenant, Datos.ClienteDocumento);
            ultimaArca = p;
            if (!p.Encontrada) { Mostrar(false, p.Error ?? "ARCA no devolvió datos para ese CUIT."); return; }

            Datos.ClienteId = null;
            Datos.ClienteNombre = p.NombreCompleto;
            if (!string.IsNullOrWhiteSpace(p.Domicilio)) Datos.ClienteDomicilio = p.Domicilio;
            if (!string.IsNullOrWhiteSpace(p.Localidad)) Datos.ClienteLocalidad = p.Localidad;
            // Si ARCA no informa la condición, queda Consumidor final.
            if (AplicaCondicion) Datos.Condicion = Condicion(p.CondicionIva);

            var avisos = new List<string>();
            if (AplicaCondicion && p.CondicionIva == null)
                avisos.Add("ARCA no informó la condición IVA: quedó Consumidor final, revisala");
            if (!string.IsNullOrWhiteSpace(p.EstadoClave) && !p.EstadoClave.Equals("ACTIVO", StringComparison.OrdinalIgnoreCase))
                avisos.Add("el CUIT figura " + p.EstadoClave.ToLowerInvariant());
            Mostrar(avisos.Count == 0, "Datos traídos de ARCA: " + p.NombreCompleto + (avisos.Count > 0 ? ". Atención: " + string.Join("; ", avisos) + "." : ""));
            await OnCambio.InvokeAsync();
        }
        catch (Exception ex)
        {
            Mostrar(false, "No se pudo consultar el padrón: " + ex.Message);
        }
        finally
        {
            consultando = false;
        }
    }

    /// <summary>Si el operador edita los datos a mano, deja de ser el cliente del fichero.</summary>
    private async Task Aviso()
    {
        Datos.ClienteId = null;
        await OnCambio.InvokeAsync();
    }

    /// <summary>Enter en el CUIT busca en ARCA.</summary>
    private async Task DocKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !consultando && !Deshabilitado) await TraerDeArca();
    }

    /// <summary>Cambió la condición frente al IVA (recalcula letra e importes).</summary>
    private async Task Cambio() => await OnCambio.InvokeAsync();

    private void Mostrar(bool ok, string t) { mensajeOk = ok; mensaje = t; }

    private static CondicionReceptor Condicion(string texto)
    {
        var t = (texto ?? "").ToUpperInvariant();
        if (t.Contains("INSCRIPTO")) return CondicionReceptor.ResponsableInscripto;
        if (t.Contains("MONOTRIBUT")) return CondicionReceptor.Monotributo;
        if (t.Contains("EXENT")) return CondicionReceptor.Exento;
        return CondicionReceptor.ConsumidorFinal;
    }
}
