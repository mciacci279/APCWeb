@* Dibujo del comprobante (ticket 80 mm o A4). Lo usan la impresión y el link público. *@
@if (c == null)
{
    <p class="page-pad">Comprobante no encontrado.</p>
}
else if (EsTicket)
{
    @* ---------------- Ticket 80 mm (térmica) ---------------- *@
    <div class="impresion ticket-80" data-autoprint="@(AutoImprimir ? "true" : "false")">
        @if (logo != null)
        {
            <img class="imp-logo" src="@logo" alt="@titular" />
        }
        <div class="tk-razon">@titular</div>
        @if (!string.Equals(titular, razon, StringComparison.OrdinalIgnoreCase))
        {
            <div class="tk-dato tk-razon-social"><span>Razón social:</span><span>@razon</span></div>
        }
        @if (!string.IsNullOrWhiteSpace(empresa.Domicilio)) { <div>@empresa.Domicilio</div> }
        <div class="tk-dato"><span>CUIT Nro:</span><span>@FormatoCuit(empresa.Cuit)</span></div>
        <div class="tk-dato"><span>Ing. Brutos:</span><span>@empresa.IngresosBrutos</span></div>
        @if (empresa.FechaInicioActividades != null)
        {
            <div class="tk-dato"><span>Inicio Act.:</span><span>@empresa.FechaInicioActividades.Value.ToString("dd/MM/yyyy")</span></div>
        }
        <div class="tk-fuerte">@CondicionEmisor</div>

        <hr class="tk-linea" />
        <div class="tk-comprobante">
            <div class="tk-fila">
                <strong>@c.NombreComprobante</strong>
                <strong>Nº: @c.NumeroCompleto</strong>
            </div>
            <div class="tk-fila tk-der"><span>@(c.EsNotaPedido ? "No válido como factura" : "Cód. " + (c.TipoComprobanteAFIP ?? 0).ToString("000"))</span><span>Fecha: @c.Fecha.ToString("dd-MM-yyyy")</span></div>
            <div class="tk-der">Hora: @c.Fecha.ToString("HH:mm:ss")</div>
            @if (c.ComprobanteAsociado != null)
            {
                <div>Comprobante asociado: @c.ComprobanteAsociado</div>
            }
        </div>

        <hr class="tk-linea" />
        <div>Forma Pago: @c.FormaPago</div>
        <hr class="tk-linea" />
        @if (EsConsumidorFinalAnonimo)
        {
            <div>A CONSUMIDOR FINAL</div>
        }
        else
        {
            <div>@c.ClienteNombre</div>
            @if (!string.IsNullOrWhiteSpace(c.ClienteCUIT)) { <div>CUIT/DNI: @c.ClienteCUIT</div> }
            @if (!string.IsNullOrWhiteSpace(c.ClienteDomicilio)) { <div>@c.ClienteDomicilio</div> }
            @if (!string.IsNullOrWhiteSpace(c.ClienteCondicionIva)) { <div>@c.ClienteCondicionIva</div> }
        }
        <hr class="tk-linea" />

        <div class="tk-renglones">
            @foreach (var r in c.Renglones)
            {
                <div>@r.CantidadRenglon.ToString("N3", Ar) x @r.PU.ToString("N2", Ar)</div>
                <div class="tk-fila">
                    <span class="tk-desc">@(string.IsNullOrWhiteSpace(r.Codigo) ? "" : $"({r.Codigo}) ")@r.Producto</span>
                    <span>@r.MontoRenglon.ToString("N2", Ar)</span>
                </div>
            }
        </div>

        @if (c.Letra == "A")
        {
            <div class="tk-fila tk-sep"><span>Neto gravado</span><span>@NetoGravado.ToString("N2", Ar)</span></div>
            <div class="tk-fila"><span>IVA</span><span>@c.MontoIva.ToString("N2", Ar)</span></div>
            @if ((c.MontoNoGravado ?? 0) > 0)
            {
                <div class="tk-fila"><span>No gravado</span><span>@c.MontoNoGravado.Value.ToString("N2", Ar)</span></div>
            }
        }
        <div class="tk-fila tk-total"><span>TOTAL</span><span>@c.MontoTotal.ToString("N2", Ar)</span></div>

        @if (c.Letra == "B")
        {
            <hr class="tk-linea" />
            <div class="tk-ley">REGIMEN DE TRANSPARENCIA FISCAL AL CONSUMIDOR (LEY 27.743)</div>
            <div class="tk-fila"><span>IVA Contenido: $</span><span>@c.MontoIva.ToString("N2", Ar)</span></div>
            <div class="tk-fila"><span>Otros Tributos Nacionales Indirectos: $</span><span>0,00</span></div>
        }

        <hr class="tk-linea" />
        <div class="tk-pie">
            @if (!string.IsNullOrEmpty(qr)) { <img class="tk-qr" src="@qr" alt="Código QR de ARCA" /> }
            <div class="tk-pie-datos">
                <span>Operador:</span>
                <span>@c.Usuario</span>
                @if (c.NumeroInterno != null) { <span class="tk-espacio">ID #: @c.NumeroInterno.Value.ToString("N0", Ar)</span> }
                @if (string.IsNullOrEmpty(c.CAE))
                {
                    <strong class="tk-espacio">@(c.EsNotaPedido ? "DOCUMENTO NO VÁLIDO COMO FACTURA" : "SIN CAE · NO VÁLIDO COMO FACTURA")</strong>
                }
                else
                {
                    <span class="tk-espacio">C.A.E. Nº:</span>
                    <span>@c.CAE</span>
                    <span>Vencimiento:</span>
                    <span>@FormatoVto(c.CAEVencimiento)</span>
                }
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(c.Observaciones))
        {
            <hr class="tk-linea" />
            <div class="tk-obs">@c.Observaciones</div>
        }
        @if (!string.IsNullOrWhiteSpace(leyenda) && !c.EsNotaCredito)
        {
            <div class="tk-gracias">@leyenda</div>
        }

        <div class="no-imprimir imp-acciones">
            <button type="button" class="btn btn-primario" onclick="window.print()">Imprimir</button>
            <a class="btn" href="@Enlace("a4")">Ver en A4</a>
        </div>
    </div>
}
else
{
    @* ---------------- Hoja A4 (diseño de la factura actual de APC) ---------------- *@
    <div class="impresion hoja-a4" data-autoprint="@(AutoImprimir ? "true" : "false")">
        <header class="fa-caja fa-cab">
            <div class="fa-emisor">
                @if (logo != null)
                {
                    <img class="imp-logo" src="@logo" alt="@titular" />
                }
                else
                {
                    <div class="fa-nombre-grande">@titular</div>
                }
                <div class="fa-datos">
                    <div><span class="fa-et">Razón Social:</span> <strong>@razon</strong></div>
                    <div><span class="fa-et">Domicilio Comercial:</span> @empresa.Domicilio</div>
                    <div><span class="fa-et">C.P.:</span> @empresa.CP <span class="fa-et fa-sep">Tel.:</span> @empresa.Telefono1</div>
                    <div><span class="fa-et">Condición frente al IVA:</span> <strong>@CondicionEmisor</strong></div>
                </div>
            </div>

            <div class="fa-letra">
                <span class="fa-letra-l">@c.Letra</span>
                <span class="fa-letra-c">@(c.EsNotaPedido ? "NO VÁLIDO COMO FACTURA" : "COD. " + (c.TipoComprobanteAFIP ?? 0).ToString("000"))</span>
            </div>

            <div class="fa-comp">
                <div class="fa-titulo">@(c.EsNotaCredito ? "NOTA DE CRÉDITO" : c.EsNotaPedido ? "NOTA DE PEDIDO" : "FACTURA")</div>
                <div class="fa-grid">
                    <span class="fa-et">Nº Comprobante:</span><strong>@c.NumeroCompleto.Replace("-", " - ")</strong>
                    <span class="fa-et">Fecha de Emisión:</span><span>@c.Fecha.ToString("dd-MM-yyyy  HH:mm:ss")</span>
                    @if (c.NumeroInterno != null)
                    {
                        <span class="fa-et">ID #:</span><span>@c.NumeroInterno.Value.ToString("N0", Ar)</span>
                    }
                    @if (c.ComprobanteAsociado != null)
                    {
                        <span class="fa-et">Comprob. asociado:</span><strong>@c.ComprobanteAsociado</strong>
                    }
                </div>
                <div class="fa-grid fa-grid-baja">
                    <span class="fa-et">CUIT Nro:</span><span>@FormatoCuit(empresa.Cuit)</span>
                    <span class="fa-et">Ing. Brutos:</span><span>@empresa.IngresosBrutos</span>
                    <span class="fa-et">Inicio Act.:</span><span>@empresa.FechaInicioActividades?.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </header>

        <section class="fa-caja fa-cliente">
            <div><span class="fa-et">Apellido y Nombres / Razón Social:</span> @(EsConsumidorFinalAnonimo ? "CONSUMIDOR FINAL" : c.ClienteNombre)</div>
            <div><span class="fa-et">CUIT Nro:</span> @c.ClienteCUIT</div>
            <div><span class="fa-et">Domicilio:</span> @c.ClienteDomicilio@(string.IsNullOrWhiteSpace(c.ClienteLocalidad) ? "" : " - " + c.ClienteLocalidad)</div>
            <div><span class="fa-et">Cond. Venta:</span> @c.FormaPago</div>
            <div><span class="fa-et">Condición frente al IVA:</span> @(string.IsNullOrWhiteSpace(c.ClienteCondicionIva) ? "CONSUMIDOR FINAL" : c.ClienteCondicionIva)</div>
            <div><span class="fa-et">Operador:</span> @c.Usuario</div>
        </section>

        <table class="fa-renglones">
            <thead>
                <tr>
                    <th>(Código) Producto</th>
                    <th class="der">Precio U.</th>
                    <th class="der">Cantidad</th>
                    <th class="der">Bonif.</th>
                    <th class="der">% Bonif.</th>
                    @if (EsA) { <th class="der">% IVA</th> }
                    <th class="der">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in c.Renglones)
                {
                    <tr>
                        <td>@(string.IsNullOrWhiteSpace(r.Codigo) ? "" : $"({r.Codigo}) ")@r.Producto</td>
                        <td class="der">@PrecioUnitario(r).ToString("N2", Ar)</td>
                        <td class="der">@r.CantidadRenglon.ToString("N3", Ar)</td>
                        <td class="der">@r.MontoDescuentoRenglon.ToString("N2", Ar)</td>
                        <td class="der">@r.DescuentoRenglon.ToString("N2", Ar)</td>
                        @if (EsA) { <td class="der">@((r.IvaRenglon ?? 0).ToString("0.##", Ar))</td> }
                        <td class="der">@Subtotal(r).ToString("N2", Ar)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="fa-medio">
            <div class="fa-izq">
                @if (c.Letra == "B")
                {
                    <div class="fa-ley">Régimen de Transparencia Fiscal al Consumidor (Ley 27.743)</div>
                    <div class="fa-ley-fila"><span>IVA Contenido: $</span><span>@c.MontoIva.ToString("N2", Ar)</span></div>
                    <div class="fa-ley-fila"><span>Otros Impuestos Nacionales Indirectos: $</span><span>0,00</span></div>
                }
            </div>
            <div class="fa-totales">
                @if (EsA)
                {
                    <div><span>Importe Neto Gravado: $</span><span>@NetoGravado.ToString("N2", Ar)</span></div>
                    @if ((c.MontoIvaTipoAfip6 ?? 0) > 0) { <div><span>IVA 27%: $</span><span>@c.MontoIvaTipoAfip6.Value.ToString("N2", Ar)</span></div> }
                    @if ((c.MontoIvaTipoAfip5 ?? 0) > 0) { <div><span>IVA 21%: $</span><span>@c.MontoIvaTipoAfip5.Value.ToString("N2", Ar)</span></div> }
                    @if ((c.MontoIvaTipoAfip4 ?? 0) > 0) { <div><span>IVA 10,5%: $</span><span>@c.MontoIvaTipoAfip4.Value.ToString("N2", Ar)</span></div> }
                    @if ((c.MontoIvaTipoAfip4 ?? 0) + (c.MontoIvaTipoAfip5 ?? 0) + (c.MontoIvaTipoAfip6 ?? 0) == 0 && c.MontoIva > 0)
                    {
                        <div><span>IVA: $</span><span>@c.MontoIva.ToString("N2", Ar)</span></div>
                    }
                    @if ((c.MontoNoGravado ?? 0) > 0) { <div><span>Importe No Gravado: $</span><span>@c.MontoNoGravado.Value.ToString("N2", Ar)</span></div> }
                }
                else
                {
                    <div><span>Subtotal: $</span><span>@c.MontoTotal.ToString("N2", Ar)</span></div>
                }
                <div><span>Importe otros Tributos: $</span><span>0,00</span></div>
                <div class="fa-total"><span>Importe Total: $</span><span>@c.MontoTotal.ToString("N2", Ar)</span></div>
            </div>
        </div>

        <div class="fa-obs"><span class="fa-et">Observaciones:</span> @c.Observaciones</div>

        <footer class="fa-pie">
            @if (!string.IsNullOrEmpty(qr)) { <img class="fa-qr" src="@qr" alt="Código QR de ARCA" /> }
            <div class="fa-autorizado">
                @if (string.IsNullOrEmpty(c.CAE))
                {
                    <strong>@(c.EsNotaPedido ? "DOCUMENTO NO VÁLIDO COMO FACTURA" : "COMPROBANTE SIN CAE — NO VÁLIDO COMO FACTURA")</strong>
                }
                else
                {
                    <strong class="fa-autorizado-tit">Comprobante Autorizado por ARCA</strong>
                    <span class="fa-chico">Esta Agencia no se responsabiliza por los datos ingresados en el detalle de la operación.</span>
                }
            </div>
            @if (!string.IsNullOrEmpty(c.CAE))
            {
                <div class="fa-grid fa-cae">
                    <strong>C.A.E. Nº:</strong><span>@c.CAE</span>
                    <strong>Fecha Vto. de CAE:</strong><span>@FormatoVto(c.CAEVencimiento)</span>
                </div>
            }
        </footer>

        <div class="no-imprimir imp-acciones">
            <button type="button" class="btn btn-primario" onclick="window.print()">Imprimir</button>
            <a class="btn" href="@Enlace("ticket")">Ver en ticket</a>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo Ar = new("es-AR");

    [Parameter] public ComprobanteImpresion C { get; set; }
    [Parameter] public EmpresaDatos Empresa { get; set; }
    [Parameter] public string Logo { get; set; }
    [Parameter] public string Leyenda { get; set; }
    [Parameter] public string Formato { get; set; }
    /// <summary>Dirección de esta misma página, sin el parámetro formato (para los botones Ticket / A4).</summary>
    [Parameter] public string UrlBase { get; set; }
    /// <summary>Abrir el diálogo de impresión al cargar.</summary>
    [Parameter] public bool AutoImprimir { get; set; } = true;
    /// <summary>Razón social de la empresa (la de la ficha de CM Tech). Vacía = la de la base del negocio.</summary>
    [Parameter] public string RazonSocial { get; set; }
    /// <summary>Nombre de fantasía del negocio. Es el que se muestra arriba cuando no hay logo.</summary>
    [Parameter] public string Fantasia { get; set; }

    private ComprobanteImpresion c => C;
    private EmpresaDatos empresa => Empresa;

    /// <summary>Lo que va en «Razón Social»: es el dato fiscal, el que figura en ARCA.</summary>
    private string razon => string.IsNullOrWhiteSpace(RazonSocial) ? empresa?.Nombre : RazonSocial.Trim();
    /// <summary>Encabezado del comprobante: el nombre con el que se conoce al negocio.</summary>
    private string titular => string.IsNullOrWhiteSpace(Fantasia) ? razon : Fantasia.Trim();
    private string logo => Logo;
    private string leyenda => Leyenda;
    private string qr => C == null ? null : FacturacionService.QrDataUri(C.QRURLAFIP);

    private string Enlace(string formato) =>
        (UrlBase ?? "") + ((UrlBase ?? "").Contains('?') ? "&" : "?") + "formato=" + formato;

    private bool EsTicket => !string.Equals(Formato, "a4", StringComparison.OrdinalIgnoreCase);
    /// <summary>
    /// Título de la página = nombre sugerido al guardar como PDF.
    /// Ej.: "Factura B 00012-00000123 - CUIT 30-71234567-8".
    /// </summary>
    public static string TituloDe(ComprobanteImpresion c, EmpresaDatos empresa) => c == null || empresa == null ? "Comprobante" :
        $"{NombreArchivo(c.NombreComprobante)} {c.NumeroCompleto} - CUIT {FormatoCuit(empresa.Cuit)}";

    /// <summary>"NOTA DE CRÉDITO B" → "Nota de Credito B" (sin tildes, para que el nombre del archivo no falle).</summary>
    private static string NombreArchivo(string nombre)
    {
        var t = CultureInfo.GetCultureInfo("es-AR").TextInfo.ToTitleCase((nombre ?? "").ToLowerInvariant())
            .Replace(" De ", " de ").Replace("é", "e").Replace("É", "E");
        var partes = t.Split(' ');
        if (partes.Length > 1 && partes[^1].Length == 1) partes[^1] = partes[^1].ToUpperInvariant();
        return string.Join(" ", partes);
    }
    private decimal NetoGravado => c.MontoTotal - c.MontoIva - (c.MontoNoGravado ?? 0);
    private bool EsA => c.Letra == "A";

    /// <summary>En la factura A los precios van sin IVA (se discrimina abajo); en B y C, con IVA incluido.</summary>
    private decimal PrecioUnitario(RenglonImpresion r) =>
        EsA && (r.IvaRenglon ?? 0) > 0 ? Math.Round(r.PU / (1 + r.IvaRenglon.Value / 100m), 2) : r.PU;

    private decimal Subtotal(RenglonImpresion r) => EsA ? r.MontoRenglon - r.MontoIvaRenglon : r.MontoRenglon;

    /// <summary>Consumidor final sin datos: se imprime "A CONSUMIDOR FINAL".</summary>
    private bool EsConsumidorFinalAnonimo =>
        string.IsNullOrWhiteSpace(c.ClienteCUIT) &&
        (c.ClienteEsConsumidorFinal || string.IsNullOrWhiteSpace(c.ClienteNombre) ||
         c.ClienteNombre.Trim().Equals("Consumidor final", StringComparison.OrdinalIgnoreCase));

    /// <summary>"IVA RESPONSABLE INSCRIPTO", "RESPONSABLE MONOTRIBUTO", etc.</summary>
    private string CondicionEmisor
    {
        get
        {
            var cond = (empresa.CondicionIva ?? "").Trim().ToUpperInvariant();
            if (cond.Length == 0) return "";
            return cond.StartsWith("IVA") || cond.Contains("MONOTRIBUTO") ? cond : "IVA " + cond;
        }
    }

    private static string FormatoCuit(string cuit)
    {
        var d = new string((cuit ?? "").Where(char.IsDigit).ToArray());
        return d.Length == 11 ? $"{d[..2]}-{d[2..10]}-{d[10]}" : cuit;
    }

    private static string FormatoVto(string v) =>
        v != null && v.Length == 8 ? $"{v[6..8]}-{v[4..6]}-{v[..4]}" : v;
}
