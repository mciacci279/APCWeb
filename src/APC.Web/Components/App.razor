<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="app.css?v=@Version" />
    <title>Factu360</title>
    @* Ícono de la pestaña: el logo de factu360.com.ar *@
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png" />
    <link rel="alternate icon" href="favicon.ico" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <meta name="theme-color" content="#0A1A3D" />
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>
<body>
    <Routes @rendermode="RenderModeForPage" />
    <script src="_framework/blazor.web.js"></script>
    <script src="app.js?v=@Version"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; }

    /// <summary>
    /// Cambia en cada compilación: se agrega a app.css y app.js para que, después de publicar, el navegador
    /// baje los archivos nuevos en lugar de usar los que tenía guardados.
    /// </summary>
    private static readonly string Version = typeof(App).Assembly.ManifestModule.ModuleVersionId.ToString("N")[..8];

    // Ingreso e impresión son páginas estáticas (sin circuito); el resto es interactivo.
    private IComponentRenderMode RenderModeForPage =>
        HttpContext.Request.Path.StartsWithSegments("/ingresar") ||
        HttpContext.Request.Path.StartsWithSegments("/imprimir") ||
        HttpContext.Request.Path.StartsWithSegments("/ver") ||
        HttpContext.Request.Path.StartsWithSegments("/admin/cobranzas/factura") ||
        HttpContext.Request.Path.StartsWithSegments("/factura-abono") ||
        HttpContext.Request.Path.StartsWithSegments("/sin-permiso") ||
        HttpContext.Request.Path.StartsWithSegments("/recuperar") ||
        HttpContext.Request.Path.StartsWithSegments("/restablecer")
            ? null
            : InteractiveServer;
}
